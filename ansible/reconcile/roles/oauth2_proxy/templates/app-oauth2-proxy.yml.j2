---
# {{ ansible_managed }}
# File-based Traefik route for {{ _app.slug }} -> {{ _app_hostname }}.
#
# Reverse-proxy mode: Traefik routes the entire host straight to the
# per-app oauth2-proxy container, which authenticates the request and
# (after auth) proxies to its `--upstream` backend itself. There is no
# forwardAuth + errors middleware chain -- oauth2-proxy emits a clean
# 302 to Keycloak when the user is unauthenticated, which the browser
# follows automatically.
#
# Priority 100 wins over the default-priority app route on the
# same Host() match, so this file-based route lands first.
#
# `oauth2-force-https-proto` rewrites X-Forwarded-Proto to https,
# because cloudflared terminates TLS at the edge but does NOT set the
# X-Forwarded-Proto header on the back-channel request to Traefik.
# Without it, oauth2-proxy constructs an http:// callback URL and
# Keycloak rejects with redirect_uri mismatch.
http:
  routers:
    {{ _app.slug }}-oauth2-proxy:
      rule: "Host(`{{ _app_hostname }}`)"
      priority: 100
      entryPoints:
        - web
      middlewares:
        - oauth2-force-https-proto
      service: {{ _app.slug }}-oauth2-proxy-svc
{% if _app.cross_site_api_refused | default(false) | bool %}
    # An upstream that signs in whoever reaches it by the gate's header takes
    # the gate's cookie as authority for every API call a browser is made to
    # send, from any site. So a browser call to /api/ that does not come from
    # the upstream's own page (Sec-Fetch-Site: same-origin) is answered 403
    # here, before the gate. noop@internal is Traefik's service for a router
    # whose middleware answers; the allowlist below admits no address, so it
    # always does. Priority 200 outranks the route above.
    {{ _app.slug }}-oauth2-proxy-cross-site-api:
      rule: "Host(`{{ _app_hostname }}`) && PathPrefix(`/api/`) && !Header(`Sec-Fetch-Site`, `same-origin`)"
      priority: 200
      entryPoints:
        - web
      middlewares:
        - {{ _app.slug }}-cross-site-api-refused
      service: noop@internal
{% endif %}

{% if _app.cross_site_api_refused | default(false) | bool %}
  middlewares:
    {{ _app.slug }}-cross-site-api-refused:
      ipAllowList:
        sourceRange:
          - "0.0.0.0/32"
        rejectStatusCode: 403

{% endif %}
  services:
    {{ _app.slug }}-oauth2-proxy-svc:
      loadBalancer:
        servers:
          - url: "http://oauth2-proxy-{{ _app.slug }}:{{ oauth2_proxy_internal_port }}"
