# {{ ansible_managed }}
# Static Keycloak client for the Beszel resource monitor's own OIDC login:
# Beszel is PocketBase underneath and keeps its own user table, so behind
# oauth2-proxy it would ask for a password a second time; this client makes
# that prompt a button. It buys UX, not access control: the gate is still
# oauth2-proxy. Password login stays on; scripts/beszel-seed.py says why.

realm: {{ keycloak_realm }}

clients:
  - clientId: "beszel"
    name: "catena Beszel"
    description: "OIDC for the Beszel resource monitor's own login form."
    enabled: true
    publicClient: false
    standardFlowEnabled: true
    implicitFlowEnabled: false
    directAccessGrantsEnabled: false
    serviceAccountsEnabled: false
    secret: "{{ beszel_oidc_client_secret }}"
    # PocketBase's fixed OAuth2 callback path. Not configurable in Beszel,
    # and version-stable: /api/oauth2-redirect is the documented value.
    redirectUris:
      - "https://{{ beszel_hostname }}/api/oauth2-redirect"
    webOrigins:
      - "+"
    defaultClientScopes:
      - groups
      - profile
      - email
      - roles
      - web-origins
    optionalClientScopes:
      - phone
      - address
      - microprofile-jwt
    attributes:
      access.token.lifespan: "3600"
      # PocketBase's OIDC provider sends PKCE by default
      # (tools/auth/oidc.go NewOIDCProvider), so unlike the Synapse and
      # Nextcloud clients this one does NOT clear the challenge method.
      post.logout.redirect.uris: "https://{{ beszel_hostname }}/*"
