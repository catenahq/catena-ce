# {{ ansible_managed }}
# Service-account client of the host-side settings sync, dashboard-sync
# (catena-admin payload/lanes/catena-dashboard-sync.py), for its two jobs on
# the realm's clients:
#   - the per-app /oauth2/callback redirect URIs on the shared `oauth2-proxy`
#     client, merged in (UNION, never removed). A converge re-import of
#     realm-oauth2-proxy.yaml.j2 resets that list to the infra hosts; the next
#     pass re-adds the client-app URIs (catena-admin
#     payload/lib/keycloak_client.py);
#   - each application's own sign-in entry, `app-<stack>`, which it creates,
#     keeps in step with the app's labels and deletes with the app. It changes
#     or deletes only the clients it marked (catena.managed-by=dashboard-sync)
#     and binds each entry to one of the sign-in flows realm-vps.yaml.j2
#     declares (catena-admin payload/lib/oidc_clients.py).
#
# Scope: a confidential client with serviceAccountsEnabled and a SINGLE
# realm-management role -- `manage-clients`, the least privilege for both
# jobs. It canNOT manage users, groups, flows or other realm config, so a
# leaked host token cannot escalate beyond client edits. It authenticates
# with the client-credentials grant (client_id + client_secret -> token).

realm: {{ keycloak_realm }}

clients:
  - clientId: "dashboard-sync"
    name: "catena dashboard-sync"
    description: "Host settings sync: per-app oauth2-proxy redirect URIs and the applications' own sign-in entries (manage-clients only)."
    enabled: true
    publicClient: false
    standardFlowEnabled: false
    implicitFlowEnabled: false
    directAccessGrantsEnabled: false
    serviceAccountsEnabled: true
    secret: "{{ dashboard_sync_client_secret }}"
    attributes:
      access.token.lifespan: "600"

# Least-privilege role grant for the dashboard-sync service account.
# kc-config-cli's schema does not recognise `serviceAccountClientRoles` on
# ClientRepresentation (Jackson fails the import with "Unrecognized field"),
# so the service-account user is declared explicitly and its clientRoles
# pinned via `serviceAccountClientId`. Keycloak auto-creates the user when
# serviceAccountsEnabled flips true on the client above; this entry decorates
# it. Every service-account client's realm file follows this pattern.
# NO_DELETE merge semantics (set in realm_bootstrap.yml) preserve other users.
users:
  - username: "service-account-dashboard-sync"
    enabled: true
    serviceAccountClientId: "dashboard-sync"
    clientRoles:
      realm-management:
        - manage-clients
