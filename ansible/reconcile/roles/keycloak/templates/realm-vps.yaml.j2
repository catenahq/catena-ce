# {{ ansible_managed }}
# Realm definition for the per-VPS SSO tenant. keycloak-config-cli
# import-update-merge semantics: re-running this against an existing
# realm reconciles delta only (groups, scopes and flows merged by
# identifier). Safe to re-apply on every converge.
#
# Rendered twice by realm_bootstrap.yml: with realm_seed false into the
# persistent realm dir, imported on every converge, and with realm_seed
# true into a seed file imported while a bootstrap marker or the realm is
# missing, and then deleted. The OIDC clients live in their own
# realm-*.yaml.j2 files beside this one.

realm: {{ keycloak_realm }}

# ─── Asserted on EVERY converge: security posture, not preference ────────
#
# registrationAllowed=false: this is an SSO tenant for one business. People are
# invited by an admin (Magic Link, or created in the Admin Portal); a login page
# that lets the internet make itself an account is not a setting this product
# has. duplicateEmailsAllowed / editUsernameAllowed likewise: the email IS the
# username here (registrationEmailAsUsername), and every gate downstream keys on
# it, so two accounts sharing one -- or an account able to rename itself into
# somebody else's -- breaks the identity the whole access model rests on.
# bruteForceProtected is the floor for a login page on the public internet.
#
# These four come back on the next converge if they are changed. Everything in
# the tunable block below does not.
registrationAllowed: false
registrationEmailAsUsername: true
duplicateEmailsAllowed: false
editUsernameAllowed: false
bruteForceProtected: true

# Second-factor enrolment, from IDENTITY_ENFORCE_MFA on the Settings page.
#
# Asserted on EVERY converge rather than seeded once, because it is a setting a
# client CHANGES: a first-import-only value could be turned on in Settings and
# never reach the realm. That also means a change made directly in the Keycloak
# admin UI is reverted here, which is the intended direction -- the Settings
# page is where this is decided, and the identity probe reports the realm's
# actual posture against it.
#
# defaultAction is the half that does the work: `enabled` only makes TOTP
# available to somebody who goes looking for it, while defaultAction attaches
# the enrolment to every account's next login. The probe reads exactly this
# pair (catena-admin payload/engines/identity), so a realm with one and not the
# other reports as drift rather than as enforced.
requiredActions:
  - alias: CONFIGURE_TOTP
    name: "Configure OTP"
    providerId: CONFIGURE_TOTP
    enabled: true
    defaultAction: {{ keycloak_enforce_mfa | bool | lower }}
    priority: 10

{% if realm_seed | bool %}
# ─── SEED ONLY: this client's own preferences ────────────────────────────
#
# Rendered only into the seed file realm_bootstrap.yml imports while a
# bootstrap marker or the realm is missing. These are then owned by whoever
# administers the realm: keycloak-config-cli's MERGE semantics leave out what
# the file does not declare, so the persistent file never asserts them and an
# edit made in the Keycloak admin UI ("Verify email" off, a wider lockout
# window, French as the default locale) survives every converge.

# The realm switched on, by the seed that creates it (realm_create). Keycloak
# creates a realm whose representation leaves `enabled` out switched off, and
# keeps the flag through an update that leaves it out
# (DefaultExportImportManager, Keycloak 26.6); keycloak-config-cli sends only
# the fields a file declares. So every other import leaves it out, the seed
# included when it runs again over an existing realm, and a realm an
# administrator switched off stays off.
{% if realm_create | bool %}
enabled: true
{% endif %}

# The name on the login page: the client's domain, which follows a new domain
# until they give the page another name (the record under attributes below).
displayName: "{{ keycloak_realm_display_name }}"
displayNameHtml: "{{ keycloak_realm_display_name | keycloak_signin_name_html }}"

# Login flow. resetPasswordAllowed=true: standard "forgot password" flow
# available on the login page.
resetPasswordAllowed: true
rememberMe: true
verifyEmail: true
loginWithEmailAllowed: true

# Brute-force numbers. Conservative to start with; tune per-client if a
# kiosk/shared-account scenario complains.
permanentLockout: false
maxFailureWaitSeconds: 900
minimumQuickLoginWaitSeconds: 60
waitIncrementSeconds: 60
quickLoginCheckMilliSeconds: 1000
maxDeltaTimeSeconds: 43200
failureFactor: 30
{% endif %}

# Four-tier group model. Groups are realm-wide; per-app gating happens
# at the per-app oauth2-proxy instance (`--allowed-group=<group>`,
# set from the compose `vps.auth.groups` label). Tiers:
#   admin    operator (full access; appended to every gated app)
#   staff    the SMB's employees; departments are subgroups of /staff
#   client   the SMB's external users (lowest authenticated tier)
#   visitor  anonymous; see the note on the group below
# /admin and /staff hold the tier roles the sign-in flows at the end of this
# file check, catena-tier-admin and catena-tier-staff. realm_bootstrap.yml
# creates them and grants each to its group after the import, adding only, so
# a role mapped to either group by hand and a role added to a tier role stay;
# this file declares neither the roles nor the groups' role mappings, which the
# import would make exact. A department inherits /staff's.
groups:
  - name: admin
    path: /admin
  - name: staff
    path: /staff
    # Departments are subgroups of staff, created in the Keycloak admin
    # UI or the People panel; the NO_DELETE import keeps them. Examples
    # only: a department declared here would come back after every deletion.
    # subGroups:
    #   - name: sales
    #     path: /staff/sales
    #   - name: accounting
    #     path: /staff/accounting
    #   - name: engineering
    #     path: /staff/engineering
  - name: client
    path: /client
  # `visitor` is seeded for documentation + the catena-admin Access
  # matrix. It is a LABEL KEYWORD meaning "public" (vps.auth.groups:
  # [visitor]); an anonymous visitor never logs in, so this group is
  # never carried in a real OIDC token. Kept here so the tier set is
  # complete and discoverable in the admin panel.
  - name: visitor
    path: /visitor

{% if realm_seed | bool %}
# Seed only, with the rest of the tunables above: which group a new account
# lands in is this client's policy, and an admin who adds a second default
# group means it.
defaultGroups:
  # New / self-service accounts land in `client` (lowest authenticated
  # tier). `staff` and `admin` are explicit-only promotions by an
  # operator -- never auto-assigned.
  - /client
{% endif %}

# Realm-wide group claim mapper. Every client created in this realm gets it
# through the realm's default client scopes, which realm_bootstrap.yml keeps
# holding it, so no client declares a mapper of its own.
clientScopes:
  - name: groups
    description: "Group memberships (top-level path) for OIDC clients."
    protocol: openid-connect
    attributes:
      include.in.token.scope: "true"
      display.on.consent.screen: "false"
    protocolMappers:
      - name: groups
        protocol: openid-connect
        protocolMapper: oidc-group-membership-mapper
        consentRequired: false
        config:
          claim.name: groups
          full.path: "false"
          id.token.claim: "true"
          access.token.claim: "true"
          userinfo.token.claim: "true"

{% if realm_seed | bool %}
# Seed only: the realm's administrator, created with the realm and then the
# account of whoever holds it, so an edit made to it in Keycloak (disabled,
# renamed, a role on an application) survives every converge. `admin` is
# appended to every gated app's allow-list by the auth engine (superuser), so
# a single `/admin` membership reaches every app from day one -- no need to
# also list staff/client. realm_bootstrap.yml puts this account back in /admin
# only when /admin has no member left.
#
# KC_BOOTSTRAP_ADMIN_* on the server container creates the admin's
# account in the MASTER realm and NOWHERE ELSE. Keycloak users are
# per-realm, so this entry is a SECOND account that shares the email.
# Without a password of its own, the same email and password open the
# master realm and are refused here, with nothing on the login page to
# say why. Its password comes from the same on-box admin_password, so there
# is one password to know.
users:
  - username: "{{ admin_email }}"
    email: "{{ admin_email }}"
    enabled: true
    emailVerified: true
    credentials:
      - type: password
        value: "{{ admin_password }}"
        temporary: false
    groups:
      - /admin
    realmRoles:
      - default-roles-{{ keycloak_realm }}
{% endif %}

# Realm-level SMTP config, from the outgoing mail chosen in the panel's
# Settings > Mail (resolved in ../defaults/main.yml). Drives password
# reset, invitations, MFA enrolment, and the verify-email send used by
# validate.yml's Vantage 1b smoke test.
#
# Asserted on EVERY converge, like the MFA action above: Settings > Mail
# is where this is decided, so a saved change (a rotated key, another
# provider) reaches the realm on the converge the save starts, and a change
# made in the Keycloak admin UI's Email tab is reverted by the next one.
# Mail turned off renders an empty map, which clears the realm's settings.
{% if smtp_enabled | bool %}
smtpServer:
  host: "{{ smtp_host }}"
  port: "{{ smtp_port }}"
  from: "{{ smtp_from }}"
  fromDisplayName: "{{ keycloak_realm_display_name }}"
  auth: "true"
  user: "{{ smtp_user }}"
  password: {{ smtp_password | default('') | to_json }}
  starttls: "{{ smtp_use_starttls | string | lower }}"
  ssl: "false"
  envelopeFrom: "{{ smtp_from }}"
{% else %}
smtpServer: {}
{% endif %}

# Phase Two extension features that ship enabled in this realm:
# - Magic Link  (separate authenticator type, exposed via the Admin
#   Portal and the dedicated Phase Two REST endpoint).
# - Organizations (multi-tenancy primitive; idle until an operator
#   creates an organization, no extra resource cost).
# - Events with webhook delivery (audit log surfaced to a sink the
#   operator picks; we don't wire one by default).
{% if realm_seed | bool %}
# Seed only, with the rest of the tunables. A realm switched to French, or
# given a third locale, is a choice about who uses it.
attributes:
  # Surface the realm as multi-language ready -- Phase Two themes
  # use this. EN + FR matches the project's bilingual stance.
  internationalizationEnabled: "true"
  supportedLocales: '["en","fr"]'
  defaultLocale: "en"
  # The login page's name as written above, which realm_bootstrap.yml compares
  # the page against before it moves the page to a new domain.
  {{ keycloak_realm_display_name_attribute }}: "{{ keycloak_realm_display_name }}"
{% endif %}

# Who may sign in through an application's own sign-in button.
#
# dashboard-sync gives an application that asks for single sign-on in its
# labels a client of its own (catena-admin payload/lib/oidc_clients.py) and
# binds that client's browser flow to one of the two flows below:
# catena-signin-admin for an application limited to administrators,
# catena-signin-staff for one open to staff. An application whose labels name
# the client group keeps the realm's browser flow, which admits every account.
# realm_bootstrap.yml reads the two flow ids for dashboard-sync after the import.
#
# Each flow runs the steps of the realm's built-in browser flow inside a
# required sub-flow (cookie, Kerberos, identity provider redirector,
# organization identity-first login, the login form with its conditional second
# factor), then a conditional sub-flow that denies an account holding none of
# the tier roles the flow admits. An account that signs in through an external
# identity provider finishes in Keycloak's broker flows and is not checked.
#
# keycloak-config-cli leaves a flow that matches this file as it is, and
# rebuilds one that differs under the same id, keeping every client bound to it.
# Configuration aliases are unique in a realm, so each copy has its own.
{% set signin_tiers = {'admin': ['catena-tier-admin'],
                       'staff': ['catena-tier-admin', 'catena-tier-staff']} %}
authenticationFlows:
{% for tier, admitted in signin_tiers.items() %}
{%   set flow = 'catena-signin-' ~ tier %}
  - alias: "{{ flow }}"
    description: "Browser sign-in for applications open to the {{ tier }} tier."
    providerId: basic-flow
    topLevel: true
    builtIn: false
    authenticationExecutions:
      - flowAlias: "{{ flow }} sign-in"
        requirement: REQUIRED
        priority: 10
        authenticatorFlow: true
      - flowAlias: "{{ flow }} tier check"
        requirement: CONDITIONAL
        priority: 20
        authenticatorFlow: true
  - alias: "{{ flow }} sign-in"
    description: "The steps of the realm's browser flow."
    providerId: basic-flow
    topLevel: false
    builtIn: false
    authenticationExecutions:
      - authenticator: auth-cookie
        requirement: ALTERNATIVE
        priority: 10
      - authenticator: auth-spnego
        requirement: DISABLED
        priority: 20
      - authenticator: identity-provider-redirector
        requirement: ALTERNATIVE
        priority: 25
      - flowAlias: "{{ flow }} organization"
        requirement: ALTERNATIVE
        priority: 26
        authenticatorFlow: true
      - flowAlias: "{{ flow }} forms"
        requirement: ALTERNATIVE
        priority: 30
        authenticatorFlow: true
  - alias: "{{ flow }} organization"
    description: "Organization identity-first login."
    providerId: basic-flow
    topLevel: false
    builtIn: false
    authenticationExecutions:
      - flowAlias: "{{ flow }} conditional organization"
        requirement: CONDITIONAL
        priority: 10
        authenticatorFlow: true
  - alias: "{{ flow }} conditional organization"
    description: "Whether the organization identity-first login applies."
    providerId: basic-flow
    topLevel: false
    builtIn: false
    authenticationExecutions:
      - authenticator: conditional-user-configured
        requirement: REQUIRED
        priority: 10
      - authenticator: organization
        requirement: ALTERNATIVE
        priority: 20
  - alias: "{{ flow }} forms"
    description: "Username, password, otp and other auth forms."
    providerId: basic-flow
    topLevel: false
    builtIn: false
    authenticationExecutions:
      - authenticator: auth-username-password-form
        requirement: REQUIRED
        priority: 10
      - flowAlias: "{{ flow }} conditional 2FA"
        requirement: CONDITIONAL
        priority: 20
        authenticatorFlow: true
  - alias: "{{ flow }} conditional 2FA"
    description: "Whether a second factor is required."
    providerId: basic-flow
    topLevel: false
    builtIn: false
    authenticationExecutions:
      - authenticator: conditional-user-configured
        requirement: REQUIRED
        priority: 10
      - authenticator: conditional-credential
        authenticatorConfig: "{{ flow }}-conditional-credential"
        requirement: REQUIRED
        priority: 20
      - authenticator: auth-otp-form
        requirement: ALTERNATIVE
        priority: 30
      - authenticator: webauthn-authenticator
        requirement: DISABLED
        priority: 40
      - authenticator: auth-recovery-authn-code-form
        requirement: DISABLED
        priority: 50
  - alias: "{{ flow }} tier check"
    description: "Denies an account holding none of the tier roles this flow admits."
    providerId: basic-flow
    topLevel: false
    builtIn: false
    authenticationExecutions:
{%   for role in admitted %}
      - authenticator: conditional-user-role
        authenticatorConfig: "{{ flow }}-without-{{ role }}"
        requirement: REQUIRED
        priority: {{ loop.index * 10 }}
{%   endfor %}
      - authenticator: deny-access-authenticator
        requirement: REQUIRED
        priority: {{ (admitted | length + 1) * 10 }}
{% endfor %}

# The second-factor condition skips the one-time code after a passkey sign-in,
# as the realm's browser flow does. Each role condition is true for an account
# WITHOUT the role, and the conditions of one sub-flow must all be true for its
# deny step to run.
authenticatorConfig:
{% for tier, admitted in signin_tiers.items() %}
  - alias: "catena-signin-{{ tier }}-conditional-credential"
    config:
      credentials: webauthn-passwordless
{%   for role in admitted %}
  - alias: "catena-signin-{{ tier }}-without-{{ role }}"
    config:
      condUserRole: {{ role }}
      negate: "true"
{%   endfor %}
{% endfor %}
