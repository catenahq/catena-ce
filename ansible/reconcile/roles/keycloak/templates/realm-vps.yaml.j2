# {{ ansible_managed }}
# Realm definition for the per-VPS SSO tenant. keycloak-config-cli
# import-update-merge semantics: re-running this against an existing
# realm reconciles delta only (groups/users/clients/protocolMappers
# merged by identifier). Safe to re-apply on every converge.
#
# Per-app OIDC clients are added to this realm AFTER bootstrap by
# dashboard-sync (plan step 5) hitting Keycloak Admin REST. Static
# clients owned by infrastructure (oauth2-proxy in plan step 4)
# extend this file as additional `clients:` entries.

realm: {{ keycloak_realm }}
enabled: true
displayName: "{{ keycloak_realm_display_name }}"
displayNameHtml: "<b>{{ keycloak_realm_display_name }}</b>"

# ─── Asserted on EVERY converge: security posture, not preference ────────
#
# registrationAllowed=false: this is an SSO tenant for one business. People are
# invited by an admin (Magic Link, or created in the Admin Portal); a login page
# that lets the internet make itself an account is not a setting this product
# has. duplicateEmailsAllowed / editUsernameAllowed likewise: the email IS the
# username here (registrationEmailAsUsername), and every gate downstream keys on
# it, so two accounts sharing one -- or an account able to rename itself into
# somebody else's -- breaks the identity the whole access model rests on.
# bruteForceProtected is the floor for a login page on the public internet.
#
# These four come back on the next converge if they are changed. Everything in
# the tunable block below does not.
registrationAllowed: false
registrationEmailAsUsername: true
duplicateEmailsAllowed: false
editUsernameAllowed: false
bruteForceProtected: true

# Second-factor enrolment, from IDENTITY_ENFORCE_MFA on the Settings page.
#
# Asserted on EVERY converge rather than seeded once, because it is a setting a
# client CHANGES: a first-import-only value could be turned on in Settings and
# never reach the realm. That also means a change made directly in the Keycloak
# admin UI is reverted here, which is the intended direction -- the Settings
# page is where this is decided, and the identity probe reports the realm's
# actual posture against it.
#
# defaultAction is the half that does the work: `enabled` only makes TOTP
# available to somebody who goes looking for it, while defaultAction attaches
# the enrolment to every account's next login. The probe reads exactly this
# pair (catena-admin payload/engines/identity), so a realm with one and not the
# other reports as drift rather than as enforced.
requiredActions:
  - alias: CONFIGURE_TOTP
    name: "Configure OTP"
    providerId: CONFIGURE_TOTP
    enabled: true
    defaultAction: {{ keycloak_enforce_mfa | bool | lower }}
    priority: 10

{% if settings_render | default(true) %}
# ─── FIRST IMPORT ONLY: this client's own preferences ────────────────────
#
# Marker-gated exactly like the smtpServer block below
# (/var/lib/catena/keycloak-realm-settings-bootstrapped, see
# realm_bootstrap.yml). These are seeded once and then owned by whoever
# administers the realm: keycloak-config-cli's MERGE semantics leave out what
# the file does not declare, so a later converge stops asserting them and an
# edit made in the Keycloak admin UI survives.
#
# Rendering them every converge is what this replaces. An admin who turned
# "Verify email" off, widened the lockout window for a shared-terminal
# scenario, added a second default group or switched the realm to French found
# it silently undone the next time anyone converged.
#
# rm the marker to re-seed these from the template.

# Login flow. resetPasswordAllowed=true: standard "forgot password" flow
# available on the login page.
resetPasswordAllowed: true
rememberMe: true
verifyEmail: true
loginWithEmailAllowed: true

# Brute-force numbers. Conservative to start with; tune per-client if a
# kiosk/shared-account scenario complains.
permanentLockout: false
maxFailureWaitSeconds: 900
minimumQuickLoginWaitSeconds: 60
waitIncrementSeconds: 60
quickLoginCheckMilliSeconds: 1000
maxDeltaTimeSeconds: 43200
failureFactor: 30
{% endif %}

# Four-tier group model. Groups are realm-wide; per-app gating happens
# at the per-app oauth2-proxy instance (`--allowed-group=<group>`,
# set from the compose `vps.auth.groups` label). Tiers:
#   admin    operator (full access; appended to every gated app)
#   staff    the SMB's employees; departments are subgroups of /staff
#   client   the SMB's external users (lowest authenticated tier)
#   visitor  anonymous; see the note on the group below
groups:
  - name: admin
    path: /admin
  - name: staff
    path: /staff
    # Departments are subgroups of staff. Operators create real ones
    # via the Keycloak admin UI; keycloak-config-cli MERGE preserves
    # any pre-existing subgroups (never set keycloak_config_destroy).
    # Examples (commented -- add your own or uncomment):
    # subGroups:
    #   - name: sales
    #     path: /staff/sales
    #   - name: accounting
    #     path: /staff/accounting
    #   - name: engineering
    #     path: /staff/engineering
  - name: client
    path: /client
  # `visitor` is seeded for documentation + the catena-admin Access
  # matrix. It is a LABEL KEYWORD meaning "public" (vps.auth.groups:
  # [visitor]); an anonymous visitor never logs in, so this group is
  # never carried in a real OIDC token. Kept here so the tier set is
  # complete and discoverable in the admin panel.
  - name: visitor
    path: /visitor

{% if settings_render | default(true) %}
# First import only, with the rest of the tunables above: which group a new
# account lands in is this client's policy, and an admin who adds a second
# default group means it.
defaultGroups:
  # New / self-service accounts land in `client` (lowest authenticated
  # tier). `staff` and `admin` are explicit-only promotions by an
  # operator -- never auto-assigned.
  - /client
{% endif %}

# Realm-wide group claim mapper. Every client in this realm inherits
# it via `client-scope`s `roles`/`profile` defaults, so per-client
# protocolMapper duplication is unnecessary.
clientScopes:
  - name: groups
    description: "Group memberships (top-level path) for OIDC clients."
    protocol: openid-connect
    attributes:
      include.in.token.scope: "true"
      display.on.consent.screen: "false"
    protocolMappers:
      - name: groups
        protocol: openid-connect
        protocolMapper: oidc-group-membership-mapper
        consentRequired: false
        config:
          claim.name: groups
          full.path: "false"
          id.token.claim: "true"
          access.token.claim: "true"
          userinfo.token.claim: "true"

# Mark the groups scope as a default scope so every new client
# auto-inherits it without per-client mapper config.
defaultDefaultClientScopes:
  - groups
  - profile
  - email
  - roles
  - web-origins

# Bootstrap admin user. `admin` is appended to every gated app's
# allow-list by the auth engine (superuser), so a single `/admin`
# membership reaches every app from day one -- no need to also list
# staff/client.
#
# KC_BOOTSTRAP_ADMIN_* on the server container creates the operator's
# account in the MASTER realm and NOWHERE ELSE. Keycloak users are
# per-realm, so this entry is a SECOND account that happens to share
# the email -- and it used to be imported with no credentials block at
# all. The same email and password opened the master realm and was
# refused here, with nothing on the login page to say why.
#
# Seeded from the same on-box admin_password so there is one password
# to know, and only on the FIRST import (admin_render_password, gated
# on a marker like the SMTP block below): rendering it every converge
# would reset the password back to the store's value each time and
# silently undo a change made in the Account Console.
users:
  - username: "{{ admin_email }}"
    email: "{{ admin_email }}"
    enabled: true
    emailVerified: true
{% if admin_render_password | default(true) %}
    credentials:
      - type: password
        value: "{{ admin_password }}"
        temporary: false
{% endif %}
    groups:
      - /admin
    realmRoles:
      - default-roles-{{ keycloak_realm }}

{% if smtp_enabled and (smtp_render_password | default(true)) %}
# Realm-level SMTP config. Auto-resolved from .env via the role's
# autofill (Resend / Brevo / raw SMTP_HOST). Drives password reset,
# invitations, MFA enrollment, and the verify-email send used by
# validate.yml's Vantage 1b smoke test.
#
# Rendered ONLY on the FIRST realm import (gated by the
# /var/lib/catena/keycloak-realm-smtp-bootstrapped marker, see
# realm_bootstrap.yml). Subsequent imports omit this block; under
# keycloak-config-cli's MERGE semantics the realm's existing
# smtpServer config (which the client may have edited via Keycloak
# admin UI / Portainer env) is preserved untouched.
smtpServer:
  host: "{{ smtp_host }}"
  port: "{{ smtp_port }}"
  from: "{{ smtp_from }}"
  fromDisplayName: "{{ keycloak_realm_display_name }}"
  auth: "true"
  user: "{{ smtp_user }}"
  password: "{{ smtp_password }}"
  starttls: "{{ smtp_use_starttls | string | lower }}"
  ssl: "false"
  envelopeFrom: "{{ smtp_from }}"
{% endif %}

# Phase Two extension features that ship enabled in this realm:
# - Magic Link  (separate authenticator type, exposed via the Admin
#   Portal and the dedicated Phase Two REST endpoint).
# - Organizations (multi-tenancy primitive; idle until an operator
#   creates an organization, no extra resource cost).
# - Events with webhook delivery (audit log surfaced to a sink the
#   operator picks; we don't wire one by default).
{% if settings_render | default(true) %}
# First import only, with the rest of the tunables. A realm switched to French,
# or given a third locale, is a choice about who uses it.
attributes:
  # Surface the realm as multi-language ready -- Phase Two themes
  # use this. EN + FR matches the project's bilingual stance.
  internationalizationEnabled: "true"
  supportedLocales: '["en","fr"]'
  defaultLocale: "en"
{% endif %}
