# {{ ansible_managed }}
# Read by catena-reboot-check.service (catena-admin payload). Pings the self-hosted
# Healthchecks loopback so a host that needs a reboot is reported once, and
# reported again when it no longer does. Empty HC_PING_KEY = the probe refuses
# rather than reporting into nothing.
HEALTHCHECKS_LOOPBACK_PORT={{ healthchecks_host_localhost_port }}
HC_PING_KEY={{ healthchecks_ping_key | default('') }}
REBOOT_CHECK_SLUG={{ reboot_check_slug }}
REBOOT_CHECK_REPORT_FILE={{ reboot_check_report_file }}
