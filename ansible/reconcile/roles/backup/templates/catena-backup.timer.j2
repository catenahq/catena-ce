[Unit]
Description=catena backup timer
# The unit ships; whether it RUNS is a licence question, and one owner answers
# it. `catena-schedule apply` reads /etc/catena/config.json, verifies the
# licence on this host, and enables or disables this timer accordingly -- an
# unlicensed host ends up with every timer off. catena-backup.service itself is
# Community and stays runnable from the panel's button whatever the licence
# says.

[Timer]
# NO OnCalendar here, and none by default, for the reason the bit-rot probe's
# timer gives: `catena-schedule apply` writes the drop-in that carries it.
# Templating a schedule in would make this file a second owner, and the next
# converge would put the old cadence back.
# Spread the fleet across a window so clients on a shared restic bucket
# do not stampede the S3 endpoint at the same instant.
RandomizedDelaySec=1h
# If the host was off at the scheduled time, run on next boot.
Persistent=true
Unit={{ backup_systemd_unit_name }}.service

[Install]
WantedBy=timers.target
