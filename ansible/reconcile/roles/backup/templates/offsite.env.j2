{{ ansible_managed | comment }}
# Dead-man endpoints for the offsite-copy lane.
#
# catena-offsite-copy.service loads this with a leading dash, so a host without
# it starts the unit and the lane simply pings nothing: the fail-soft contract.
#
# Separate from backup.env next door because backup.env is rewritten only once
# the host's backup is configured, and these endpoints apply on every converge
# either way. Retention lives in backup-retention.env, which catena-schedule
# writes.
#
# WHICH buckets are copied lives in the `offsite_copies` list in
# /etc/catena/config.json, written by catena-admin and read straight off disk by
# the lane, so adding a copy takes effect on the next run with no converge in
# between.
#
# One pair of checks for the whole lane, not one per copy: a check that appears
# and disappears as a client edits the list is a monitoring surface that churns,
# and the run's single signal already names the copies it is about.

OFFSITE_HEALTHCHECK_URL={{ offsite_healthcheck_url }}
OFFSITE_HEALTHCHECK_ATTEMPTED_URL={{ offsite_healthcheck_attempted_url }}
