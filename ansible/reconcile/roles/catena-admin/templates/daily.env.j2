{{ ansible_managed | comment }}
# Per-host configuration for the maintenance (the catena-daily orchestrator).
#
# catena-daily.service and catena-daily-resume.service declare
# EnvironmentFile for this path with no leading dash, so systemd fails the
# unit when it is missing. That is deliberate on their side: a maintenance that
# ran with every path defaulted would back up the wrong directory and report
# success.
#
# Only the values that differ per host live here; every other key (the state
# files, the lane workers, the cold-verify requirement) takes the engine's own
# default. Credentials come from /etc/catena/config.json, which the engines
# read directly.
#
# The maintenance's SCHEDULE is not here -- `catena-schedule apply` owns which
# timers are enabled and at what OnCalendar, from the same config store the
# admin panel writes.

# Units the maintenance drives synchronously rather than scheduling separately.
DAILY_BACKUP_UNIT={{ backup_systemd_unit_name | default('catena-backup') }}
DAILY_STACK_UPDATE_UNIT=catena-stack-update-managed
DAILY_OFFSITE_COPY_UNIT=catena-offsite-copy

# Abort the run before pg_dumpall writes a byte if the staging mount is below
# this floor. The same number the standalone backup preflight uses.
DAILY_PREFLIGHT_MIN_BYTES={{ backup_preflight_min_bytes | default(5368709120) }}
DAILY_PREFLIGHT_STAGING_DIR={{ storage_mount_point }}/backup-staging

# Pre-update health gate: the maintenance stops before the updates while an endpoint
# Gatus monitors fails its latest check, and goes on without the gate when
# Gatus does not answer.
DAILY_GATUS_API_URL={{ catena_gatus_statuses_url }}
