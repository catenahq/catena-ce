# {{ ansible_managed }}
#
# Managed by reconcile/roles/traefik. Do NOT edit by hand -- changes are
# clobbered on the next `catena converge` run.
#
# Static Traefik config for the catena-owned `catena-traefik` container,
# with two additions on top of the base entryPoints/providers/api config:
#
#   1. entryPoints.<entrypoint>.forwardedHeaders.trustedIPs
#      Tells Traefik to trust X-Forwarded-* headers from the overlay
#      (10/8) and Docker bridges (172.16/12, 127/8).
#
#   2. entryPoints.web.http.middlewares with a request-header
#      injector that sets X-Forwarded-Proto: https.
#      Required because cloudflared (the ONLY ingress on the :80
#      entrypoint, given the UFW + DOCKER-USER lockdown) does NOT
#      send X-Forwarded-Proto -- it sends Cf-Visitor:
#      {"scheme":"https"} instead, which Keycloak (and most other
#      backends) does not read. Without injection, Keycloak sees the
#      :80 connection as a plain-HTTP request, logs "Non-secure
#      context detected" twice per second, refuses Secure cookies,
#      and the account-console SPA loops on cross-origin POSTs.
#
# Lockdown invariant: ONLY cloudflared can reach :80. UFW blocks
# public ingress on :80; DOCKER-USER drops port 3000 from
# non-tailnet/non-RFC1918; the overlay is the only path that can hit
# :80 from outside the host. Therefore we can safely declare the :80
# entrypoint "always behind HTTPS at the edge" and rewrite
# X-Forwarded-Proto unconditionally.
global:
  sendAnonymousUsage: false
providers:
  swarm:
    exposedByDefault: false
    watch: true
  docker:
    exposedByDefault: false
    watch: true
    network: {{ catena_network_name }}
  file:
    directory: {{ traefik_dynamic_dir }}
    watch: true
entryPoints:
  web:
    address: :80
    forwardedHeaders:
      trustedIPs: {{ traefik_trusted_ips | to_yaml }}
    # Inject X-Forwarded-Proto: https on every request because the
    # only ingress on :80 is cloudflared, and cloudflared does NOT
    # set the header itself (only Cf-Visitor). Middleware ref points
    # at the file provider's `cf-forwarded-proto-https` definition
    # in dynamic/cf-forwarded-proto-https.yml.
    http:
      middlewares:
        - cf-forwarded-proto-https@file
        - catena-secure-headers@file
# NO `websecure` entrypoint, and no certificatesResolvers.
#
# TLS terminates at Cloudflare. cloudflared reaches this proxy at
# http://catena-traefik:80 over catena-network and the service publishes no
# host ports, so :443 is reachable from nowhere. Every route catena generates
# is `web`-only: app-route.yml.j2 (portainer_stack) and both route_synth
# variants (dashboard-sync).
#
# A certResolver on this entrypoint is therefore an ACME order waiting for an
# accident. A container labelled traefik.enable=true with no rule gets the
# docker provider's built-in Host(`{{ '{{' }} normalize .Name {{ '}}' }}`)
# default, and that DOTLESS router inherits the entrypoint's resolver -- so a
# converge asks a public CA for a name no CA can issue and burns
# failed-validation quota on the account. Declaring no resolver removes the
# mechanism. ce_install_suite's stage-3e-no-public-acme guards the property.
#
# Restoring TLS here takes four things together: an entrypoint, a resolver
# with a real notification email, a published :443, and a caServer so a bench
# never reaches a public CA.
api:
  insecure: true
# Enables the /ping endpoint on the internal `traefik` entrypoint (:8080,
# created by api.insecure above). This exists for ONE reason: the swarm
# service healthcheck runs `traefik healthcheck`, and that subcommand refuses
# to do anything without ping -- it exits 1 with "please enable `ping` to use
# health check". With it, `docker service ls` reporting 1/1 for catena-traefik
# means the proxy is answering, not merely that the process started.
#
# Not a new exposure: :8080 is internal to the container's netns and the
# entrypoint is not published, exactly like the api dashboard it rides on.
ping: {}
