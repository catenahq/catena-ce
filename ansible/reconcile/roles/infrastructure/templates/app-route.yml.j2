# {{ ansible_managed }}
#
# Traefik file-provider route for {{ svc_name }} -> {{ svc_domain_host }}.
# Written by reconcile/roles/infrastructure/tasks/swarm_stack.yml for a service
# no sign-in gate serves; catena-traefik serves it directly via the file
# provider (the control plane does no reverse proxy).
#
# Backend: http://{{ svc_domain_service }}:{{ svc_domain_port }} on
# catena-network -- the service's own network alias.
# X-Forwarded-Proto: https is injected globally on the :80 entrypoint (see
# reconcile/roles/traefik/templates/traefik.yml.j2), so no per-route middleware here.
http:
  routers:
    {{ svc_name }}-route:
      rule: "Host(`{{ svc_domain_host }}`){% for h in svc_domain_extra_hosts | default([]) %} || Host(`{{ h }}`){% endfor %}"
      entryPoints:
        - web
      service: {{ svc_name }}-route-svc
  services:
    {{ svc_name }}-route-svc:
      loadBalancer:
        servers:
          - url: "http://{{ svc_domain_service }}:{{ svc_domain_port }}"
