# {{ ansible_managed }}
# 00-base.yaml -- Ansible-managed foundation for Gatus. Two siblings:
#   50-catena-apps.yaml    written by /usr/local/bin/gatus-sync on a timer
#                           (one internal + one public endpoint per client
#                           app with a domain).
#   99-<anything>.yaml      operator-added, never touched by either.
#
# Gatus loads every *.yaml under /config alphabetically and merges them.
# Conditions are evaluated server-side: see https://gatus.io/docs/conditions.
#
# Two-monitor model per gated service: probing the INTERNAL alias tests
# the app is running; probing the
# PUBLIC URL with [STATUS] == 302 as healthy tests the full CF Tunnel ->
# Traefik -> per-app oauth2-proxy chain (302 = oauth2-proxy redirecting
# unauthed requests to Keycloak, which means every layer in front is
# healthy). Native-OIDC apps are the exception: they return 200 on /
# (their own SPA shell), so their probe accepts 200 instead.
# Internal down + public up -> app broken. Internal up + public down ->
# tunnel / Traefik / oauth2-proxy broken. Full diagnostic coverage,
# zero credentials inside Gatus.
#
# Endpoint naming: `<hostname or alias> (<service label>)` so the
# downstream notification body (posted to Healthchecks, then fanned out
# via the client-configured integrations -- see alerting.custom below
# for the webhook wiring) carries enough context to identify what's
# down without opening the status page.

{# ─── Labels (client-facing status page + notification titles) ───
   Gatus has no upstream i18n, so we author these labels ourselves. They
   are English: Gatus renders one static config per host with no per-viewer
   language, unlike catena-admin where each visitor picks their own.   #}
{% set _labels = {
    'service_status': 'service status',
    'live_status':    'Live status of the catena stack on',
    'open_for':       'open',
    'for_detail':     'for detail',
    'gatus_status':   'Gatus status page',
    'auth_login':     'Keycloak login',
} %}

storage:
  type: sqlite
  path: /data/gatus.db

ui:
  title: "{{ cloudflare_zone }} -- {{ _labels.service_status }}"
  description: "{{ _labels.live_status }} {{ inventory_hostname }}"
  header: "{{ cloudflare_zone }}"
  default-sort-by: group
  # Dashboard subheading explains the `<version>` (angle-bracket)
  # convention used on service cards for images that aren't on the
  # weekly auto-update safety net. Gatus renders it as plain text
  # (no markdown / HTML -- see web/app/src/views/Home.vue), so the
  # docs URL is shown verbatim; the "Docs" button below is the
  # clickable entry point. Single-line quoted scalar on purpose:
  # YAML folded-block (`>-`) + Jinja whitespace stripping fuses the
  # next top-level key into the subheading text.
  dashboard-subheading: "Services with their version shown in ⟨ ⟩ are not auto-updated. See the docs to learn more at catena.run/docs. Click on any service for more details."
  buttons:
    - name: "Docs"
      link: "https://catena.run/docs"

alerting:
  # Gatus pipes every alert to Healthchecks instead of ntfy directly.
  # Rationale (decided 2026-04-19):
  #   - Clients need to own their notification channels (email, Slack,
  #     Discord, ...). Gatus's alerting providers are config-as-code --
  #     no UI to add channels. Healthchecks has a full per-user
  #     integration UI, gated by oauth2-proxy + Keycloak SSO. One
  #     notification plane wins: clients add integrations in
  #     heartbeat.<zone>, Gatus just pushes state transitions.
  #   - The operator's default ntfy channel is auto-provisioned in
  #     Healthchecks (see reconcile/roles/infrastructure/tasks/healthchecks.yml
  #     Django seed), so the existing operator-ntfy flow keeps working
  #     with zero client-visible surface.
  #
  # URL + placeholder trick: Gatus's `custom` provider templates the URL
  # with:
  #   - [ALERT_DESCRIPTION] -> per-endpoint slug, makes Healthchecks
  #     auto-create a distinct check per service so the ntfy title reads
  #     "gatus-<service> is DOWN" instead of a single aggregate name.
  #   - [ALERT_TRIGGERED_OR_RESOLVED] -> /fail for failures, empty for
  #     recoveries (pings the success endpoint).
  # `?create=1` auto-provisions the check on first failure.
  # Healthchecks assigns ALL project-level channels to new checks, so
  # the operator ntfy channel (seeded in healthchecks-seed.py) is
  # attached automatically without per-check wiring.
  #
  # Every endpoint below sets `description:` on its alert (overriding
  # default-alert.description), and that description is the slug.
  # Derived from endpoint name so operators reading both the Gatus UI
  # and the Healthchecks UI get obvious pairings.
  custom:
    url: "http://{{ healthchecks_network_alias }}:{{ healthchecks_internal_port }}/ping/{{ healthchecks_ping_key }}/gatus-[ALERT_DESCRIPTION][ALERT_TRIGGERED_OR_RESOLVED]?create=1"
    method: "POST"
    body: |
      [ENDPOINT_GROUP] / [ENDPOINT_NAME]
      Conditions: [CONDITION_RESULTS]
      Status page: https://{{ infrastructure_gatus_hostname }}
    placeholders:
      ALERT_TRIGGERED_OR_RESOLVED:
        TRIGGERED: "/fail"
        RESOLVED: ""
    default-alert:
      failure-threshold: 3
      success-threshold: 2
      send-on-resolved: true

# NOTE: the per-service infra endpoints (internal + public) live in
# 40-infra.yaml, generated by /usr/local/bin/gatus-sync from
# gatus-infra-spec.json so that the endpoint NAME can include live
# current/latest version info from /var/lib/catena/version-check.json.
# Per-app endpoints live in 50-catena-apps.yaml (also gatus-sync).
# Gatus merges the `endpoints:` lists from every sibling 40-/50-/99-
# yaml file with the one below via its native multi-file merge.
#
# The self-check below is the ONE endpoint 00-base.yaml must always
# carry. Gatus (>= v5.36) refuses to boot when the MERGED config
# defines zero endpoints -- it panics with "configuration should
# contain at least one endpoint or suite". gatus.yml deploys this
# container early in reconcile/roles/infrastructure, long before gatus_sync.yml
# writes 40-infra.yaml / 50-catena-apps.yaml, so without a baked-in
# endpoint the container crash-loops from first boot until sync runs.
# That crash-loop churns catena-network (constant veth create/teardown)
# hard enough to starve the converge's own SSH channel, surfacing as a
# spurious become-timeout UNREACHABLE on an unrelated task. The probe
# targets Gatus's own /health on the loopback web port, so it is valid
# and self-contained the instant the process starts; it carries no
# `alerts:` (a monitor that is down cannot page about itself).
endpoints:
  # The name carries the migration, and the parentheses are what it cost.
  #
  # This endpoint's group said "infrastructure" while every entry in
  # gatus-infra-spec.json.j2 says "Infrastructure". Gatus renders the group
  # string verbatim, so the status page grew a second Infrastructure section
  # with this one endpoint stranded in it.
  #
  # Correcting the capitalisation alone fixes a FRESH install and silently does
  # nothing to a running one. Gatus stores the rendered group in SQLite and the
  # dashboard reads it from there, not from this file; the row is found by
  # `sanitize(group) + "_" + sanitize(name)`, and sanitize lowercases -- so
  # "infrastructure" and "Infrastructure" are the same key. The row is
  # therefore never missing, `endpoint_group` is only ever written on INSERT,
  # and `DeleteAllEndpointStatusesNotInKeys` keeps a key it still sees. The old
  # spelling outlives any number of converges and restarts.
  #
  # Dropping the parentheses changes the NAME, which changes the key, which
  # makes Gatus purge the stale row at startup and insert a fresh one carrying
  # this group. The converge migrates an already-running host by itself, with
  # no hand-written SQL against a database another process holds open. The cost
  # is this endpoint's history, which is a self-check on the monitor that would
  # be down if it mattered.
  - name: "Gatus self-check"
    group: "Infrastructure"
    url: "http://localhost:{{ gatus_internal_port }}/health"
    interval: 60s
    conditions:
      - "[STATUS] == 200"
