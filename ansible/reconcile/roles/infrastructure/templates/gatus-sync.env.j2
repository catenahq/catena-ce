# {{ ansible_managed }}
# Config for /usr/local/bin/catena-gatus-sync. 0600 root:root.
# gatus-sync reads client apps from the app intent dashboard-sync writes
# (/var/lib/catena/app-intent.json), so no API base/key is needed.
GATUS_CONFIG_PATH={{ gatus_host_config_dir }}/50-catena-apps.yaml
# Infra endpoint generation (40-infra.yaml from gatus-infra-spec.json).
# version-check.json, which catena-version-check.timer refreshes, adds
# version info to endpoint NAMES; while it is absent the suffix is skipped
# (best-effort).
GATUS_INFRA_SPEC_PATH={{ gatus_infra_spec_path }}
GATUS_INFRA_CONFIG_PATH={{ gatus_host_config_dir }}/40-infra.yaml
VERSION_CHECK_PATH={{ version_check_output_file }}
# Regex to find the running Gatus container in `docker ps` output. Swarm
# names stack task containers `<stack>_<service>.<slot>.<taskid>`, and the
# taskid is regenerated on every restart -- which is why this is a regex
# resolved at use time rather than a name gatus-sync could hold.
GATUS_CONTAINER_NAME_RE={{ gatus_compose_name | swarm_container_regex("app") }}
# Where gatus-sync writes its count of Gatus's endpoints up and down on every
# run, read by the panel's System tab. Empty disables it.
GATUS_SUMMARY_PATH={{ gatus_summary_file }}
# gatus-sync runs on the host, so it reaches Gatus on its loopback publish.
GATUS_API_URL=http://127.0.0.1:{{ gatus_host_localhost_port }}
# The orphan-pause pass at the end of gatus-sync: for every HC check named
# `gatus-*` whose endpoint isn't in the current Gatus config, POST /pause/.
# Pausing takes the read-write key. Empty key = orphan cleanup disabled.
HEALTHCHECKS_API_URL=http://127.0.0.1:{{ healthchecks_host_localhost_port }}/api/v3/checks/
HEALTHCHECKS_API_KEY_RW={{ healthchecks_api_key_readwrite | default('') }}
