{# The services of Catena's own that catena-uptime (catena-admin payload) checks
   every minute, beside the applications it reads off the app intent. One entry
   per address: name and name_fr are what the Uptime page shows, accepted the
   statuses that count as up, alert_slug the id the alert intake keeps the
   target under.

   stack names the app folder of a default app. catena-uptime leaves an entry
   out while its stack has no folder, so a monitor an admin removed stops
   alerting instead of reading green through its gate.

   An entry that reaches its service through the public edge, at a name under
   the domain, is written only while the edge serves the domain: a Cloudflare
   token in the store, the tunnel engine on the host
   (reconcile/roles/infrastructure/tasks/main.yml _infra_edge_up) and a domain.
   A name asked before the domain's wildcard record exists is answered NXDOMAIN,
   and resolvers keep that answer for the zone's negative TTL, 30 minutes on
   Cloudflare, so a probe written early reads red that long after the edge comes
   up. A converge runs reconcile/roles/cloudflare_tunnel before this role, so
   the wildcard exists before the first check. #}
{% set _through_the_edge = (_infra_edge_up | bool)
     and not (catena_public_surface_deferred | bool) %}
{"version": 1, "targets": [
{% if _through_the_edge %}
{# catena-admin (the Go shell) is the admin panel. It sits behind the
   staff/admin oauth2-proxy slug, so an unauthenticated check gets a 302
   to the auth flow. #}
  {"name": "Administration panel", "name_fr": "Panneau d'administration",
   "url": "https://{{ catena_admin_hostname }}", "accepted": [302],
   "alert_slug": "{{ catena_admin_hostname | lower | replace('.', '-') }}"},
{# Keycloak's realm discovery document is public by design and answers 200
   while it serves. Beszel's host sits behind oauth2-proxy and answers the
   sign-in redirect. #}
  {"name": "Sign-in (Keycloak)", "name_fr": "Connexion (Keycloak)",
   "url": "https://{{ keycloak_hostname }}/realms/{{ keycloak_realm }}/.well-known/openid-configuration",
   "accepted": [200],
   "alert_slug": "{{ keycloak_hostname | lower | replace('.', '-') }}"},
  {"name": "Resource monitor (Beszel)", "name_fr": "Moniteur de ressources (Beszel)",
   "url": "https://{{ beszel_hostname }}", "accepted": [302],
   "alert_slug": "{{ beszel_hostname | lower | replace('.', '-') }}",
   "stack": "{{ beszel_hub_stack }}"},
{# The tunnel, through a name under the domain's wildcard that nothing routes:
   the Cloudflare edge hands it to this host's connector, which passes it to
   Traefik, and Traefik answers 404 for a host it has no route for. A connector
   that is down gets 530 from the edge, and one whose ingress does not serve
   the domain answers the tunnel's catch-all 418
   (catena-admin/payload/engines/cloudflared/api.go catchAllService), so only
   a working tunnel reaches 404. The tunnel engine's own chain probe asks the
   same way, under a fresh name each time. #}
  {"name": "Cloudflare tunnel", "name_fr": "Tunnel Cloudflare",
   "url": "https://cf-chain-probe.{{ cloudflare_zone }}/", "accepted": [404],
   "alert_slug": "cloudflared"},
{% endif %}
{# Beszel's hub on its host loopback publish. Its public host answers 302 from
   oauth2-proxy whatever the hub's state, so the hub itself is asked too:
   /api/health answers 200 while it serves. #}
  {"name": "Beszel hub", "name_fr": "Hub Beszel",
   "url": "http://127.0.0.1:{{ beszel_hub_host_localhost_port }}/api/health", "accepted": [200],
   "alert_slug": "beszel-hub",
   "stack": "{{ beszel_hub_stack }}"}
]}
