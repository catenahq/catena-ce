[
  {
    "label": "catena-traefik",
    "url": "http://catena-traefik:80/",
    "group": "Infrastructure",
    "accepted": [200, 404],
    "ignore_redirect": false,
    "interval": "60s",
    "alert_slug": "traefik-internal",
    "version_key": "Traefik"
  },
  {
    "label": "{{ infrastructure_gatus_hostname }}",
    "url": "https://{{ infrastructure_gatus_hostname }}",
    "group": "Infrastructure",
    "accepted": [302],
    "ignore_redirect": true,
    "interval": "120s",
    "alert_slug": "{{ infrastructure_gatus_hostname | lower | replace('.', '-') }}",
    "version_key": "Gatus"
  },
{# catena-admin (the Go shell) is the admin panel. It sits behind the
   staff/admin oauth2-proxy slug, so an unauthenticated probe gets a 302
   to the auth flow. #}
  {
    "label": "{{ catena_admin_hostname }}",
    "url": "https://{{ catena_admin_hostname }}",
    "group": "Infrastructure",
    "accepted": [302],
    "ignore_redirect": true,
    "interval": "120s",
    "alert_slug": "{{ catena_admin_hostname | lower | replace('.', '-') }}",
    "version_key": "catena-admin"
  },
{# Portainer, the container control plane, is public + admin-gated at
   portainer.<zone> over the CF tunnel (as well as tailnet-only :9000). An
   unauthenticated probe gets a 302 to the auth flow. #}
  {
    "label": "{{ portainer_admin_hostname }}",
    "url": "https://{{ portainer_admin_hostname }}",
    "group": "Infrastructure",
    "accepted": [302],
    "ignore_redirect": true,
    "interval": "120s",
    "alert_slug": "{{ portainer_admin_hostname | lower | replace('.', '-') }}",
    "version_key": "Portainer"
  },
  {
    "label": "{{ healthchecks_hostname }}",
    "url": "https://{{ healthchecks_hostname }}",
    "group": "Infrastructure",
    "accepted": [302],
    "ignore_redirect": true,
    "interval": "120s",
    "alert_slug": "{{ healthchecks_hostname | lower | replace('.', '-') }}",
    "version_key": "Healthchecks"
  },
  {
    "label": "Restic backup",
    "url": "http://homepage-stats/backup-stats.json",
    "group": "Infrastructure",
    "accepted": [200],
    "ignore_redirect": false,
    "interval": "300s",
    "alert_slug": "restic-backup",
    "version_key": "Restic",
    "extra_conditions": [
      "[BODY].status == ok"
    ]
  },
  {
    "label": "Container CVE inventory",
    "url": "http://homepage-stats/container-cve-findings.json",
    "group": "Infrastructure",
    "accepted": [200],
    "ignore_redirect": false,
    "interval": "3600s",
    "alert_slug": "container-cve-inventory",
    "version_key": null,
    "extra_conditions": [
      "[BODY].count_critical == 0",
      "[BODY].count_high <= {{ container_cve_high_threshold | default(10) }}"
    ]
  },
{# The tunnel, through a name under the domain's wildcard that nothing routes:
   the Cloudflare edge hands it to this host's connector, which passes it to
   Traefik, and Traefik answers 404 for a host it has no route for. A connector
   that is down gets 530 from the edge, and one whose ingress does not serve
   the domain answers the tunnel's catch-all 418
   (catena-admin/payload/engines/cloudflared/api.go catchAllService), so only
   a working tunnel reaches 404. The tunnel engine's own chain probe makes the
   same request. #}
  {
    "label": "cloudflared",
    "url": "https://cf-chain-probe.{{ cloudflare_zone }}/",
    "group": "Infrastructure",
    "accepted": [404],
    "ignore_redirect": false,
    "interval": "120s",
    "alert_slug": "cloudflared",
    "version_key": "Cloudflared"
  },
{# Keycloak's readiness on its management port, over catena-network: the
   same check its container healthcheck runs. #}
  {
    "label": "Keycloak",
    "url": "http://{{ keycloak_server_alias }}:{{ keycloak_management_port }}{{ keycloak_health_path }}",
    "group": "Infrastructure",
    "accepted": [200],
    "ignore_redirect": false,
    "interval": "60s",
    "alert_slug": "keycloak",
    "version_key": "Keycloak"
  },
{# Beszel's hub, by its catena-network alias. Its public host sits behind
   oauth2-proxy and answers 302 whatever the hub's state, so the hub itself
   is asked: /api/health answers 200 while it serves. #}
  {
    "label": "Beszel hub",
    "url": "http://{{ beszel_hub_network_alias }}:{{ beszel_hub_internal_port }}/api/health",
    "group": "Infrastructure",
    "accepted": [200],
    "ignore_redirect": false,
    "interval": "60s",
    "alert_slug": "beszel-hub",
    "version_key": "Beszel"
  }
]
