---
# {{ ansible_managed }}
# Beszel -> Healthchecks alert shim. Receives Beszel's Shoutrrr generic
# webhook and maps triggered/resolved to Healthchecks /fail + success
# pings so Beszel threshold alerts ride the same notification plane as
# Gatus (clients keep their self-service channels). See
# ops/internal_docs/tools/notifications.md and
# catena-ce/ansible/scripts/beszel-hc-shim.py.
#
# No public surface: no route points at it. Reachable on beszel_network at
# {{ beszel_hc_shim_network_alias }}:{{ beszel_hc_shim_internal_port }}, where
# the hub is its one caller: catena-ce/ansible/scripts/beszel-seed.py points
# the hub's webhook at
# generic+http://{{ beszel_hc_shim_network_alias }}:{{ beszel_hc_shim_internal_port }}/notify
# Any request it takes becomes a Healthchecks ping, so no client app reaches it.
services:
  app:
    image: {{ beszel_hc_shim_image }}
    deploy:
      restart_policy:
        condition: any
        delay: 5s
    command: ["python3", "/app/beszel-hc-shim.py"]
    environment:
      HC_URL: "http://{{ healthchecks_network_alias }}:{{ healthchecks_internal_port }}"
      LISTEN_PORT: "{{ beszel_hc_shim_internal_port }}"
      # The ping key is a swarm secret (beszel_hc_shim_swarm_secrets in
      # ../defaults/main.yml), read from the file HC_PING_KEY_FILE names, so
      # `docker service inspect` shows a path.
{% for _secret in _beszel_hc_shim_secrets %}
      {{ _secret.target }}_FILE: "/run/secrets/{{ _secret.target }}"
{% endfor %}
    volumes:
      - {{ beszel_hc_shim_host_dir }}:/app:ro
    networks:
      {{ beszel_network }}:
        aliases:
          - {{ beszel_hc_shim_network_alias }}
      # Where HC_URL answers: Healthchecks is on no other network.
      {{ healthchecks_network }}: {}
    secrets:
{% for _secret in _beszel_hc_shim_secrets %}
      - source: {{ _secret.name }}
        target: {{ _secret.target }}
{% endfor %}

networks:
  {{ beszel_network }}:
    external: true
  {{ healthchecks_network }}:
    external: true

# Created and named by playbooks/tasks/swarm_secrets.yml before this deploys.
secrets:
{% for _secret in _beszel_hc_shim_secrets %}
  {{ _secret.name }}:
    external: true
{% endfor %}
