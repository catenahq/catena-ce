---
# {{ ansible_managed }}
# Beszel agent -- collects per-container + per-host CPU/memory/network/
# disk/temperature/load and reports to the hub. Replaces the cAdvisor +
# catena-resource-sampler scrape lane.
#
# network_mode: host is the canonical upstream shape for a Docker agent
# that must report HOST metrics (not just its own container's): it reads
# the host network + cgroup state directly, and reaches the docker daemon
# via the read-only socket mount. With host networking the agent dials
# the hub over the host loopback publish rather than a catena-network
# alias.
#
# Auth: KEY is the hub's public SSH key, read back from the running hub
# at converge time (beszel.yml derives _beszel_hub_pubkey via ssh-keygen
# -y on /beszel_data/id_ed25519). The token is the seeded universal token, so
# the hub auto-creates this system on first WebSocket connect
# (createNewSystemForUniversalToken). No Traefik surface.
services:
  app:
    image: {{ beszel_agent_image }}
    deploy:
      restart_policy:
        condition: any
        delay: 5s
      # The agent reports the metrics of the node it runs on, read
      # through that node's docker socket. Unpinned it would measure
      # whichever node swarm picked and report it as this one.
      placement:
        constraints:
          - node.labels.catena.role==data
    # `network_mode: host` is a COMPOSE key that `docker stack deploy`
    # ignores in silence -- the agent would land on the stack's default
    # overlay, report that network's namespace as "the host", and dial a
    # 127.0.0.1 hub that is not there. Under swarm the host namespace is
    # requested by attaching to the predefined `host` network, declared
    # external below.
    networks:
      - hostnet
    environment:
      LISTEN: "{{ beszel_agent_port }}"
      HUB_URL: "http://127.0.0.1:{{ beszel_hub_host_localhost_port }}"
      KEY: "{{ _beszel_hub_pubkey }}"
      # The token is a swarm secret (beszel_agent_swarm_secrets in
      # ../defaults/main.yml), read from the file TOKEN_FILE names, so
      # `docker service inspect` shows a path.
{% for _secret in _beszel_agent_secrets %}
      {{ _secret.target }}_FILE: "/run/secrets/{{ _secret.target }}"
{% endfor %}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    secrets:
{% for _secret in _beszel_agent_secrets %}
      - source: {{ _secret.name }}
        target: {{ _secret.target }}
{% endfor %}
    labels:
      - traefik.enable=false

networks:
  # Docker's predefined host network. Not created by us and not removed by
  # `--prune`; the alias exists only because a compose service can attach to
  # a network by key, not by literal name.
  hostnet:
    external: true
    name: host

# Created and named by playbooks/tasks/swarm_secrets.yml before this deploys.
secrets:
{% for _secret in _beszel_agent_secrets %}
  {{ _secret.name }}:
    external: true
{% endfor %}
