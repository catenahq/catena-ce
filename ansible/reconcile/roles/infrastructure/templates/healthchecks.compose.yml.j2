---
# {{ ansible_managed }}
# Self-hosted Healthchecks (the open-source project that powers
# healthchecks.io). Single container, SQLite storage -- no Postgres
# sidecar, no metrics firehose. Purpose-built for cron/dead-man
# monitoring.
#
# SQLite lives under a named Docker volume -> gets backed up by restic
# as part of /srv/catena/docker/volumes. Check definitions + ping history
# survive a restore.
services:
  app:
    image: {{ healthchecks_image }}
    deploy:
      restart_policy:
        condition: any
        delay: 5s
      # healthchecks-data is the SQLite database holding every check
      # and its ping history. An empty one on another node is a
      # monitoring plane that has forgotten what it watches.
      placement:
        constraints:
          - node.labels.catena.role==data
    environment:
      # A host with no domain yet has no public name to be reached at, and
      # `<sub>.` with the zone empty is not a degraded name -- it is one Django
      # rejects. SITE_ROOT https://<sub>. normalises to host "<sub>", which
      # ALLOWED_HOSTS' "<sub>." does not match, and Healthchecks refuses to
      # start (hc.api.E002) when SITE_ROOT's host is not an allowed one.
      # Deferred, it addresses itself by the network alias every on-box
      # consumer already dials.
{% if catena_public_surface_deferred | default(false) | bool %}
      SITE_ROOT: "http://{{ healthchecks_network_alias }}:{{ healthchecks_internal_port }}"
      SITE_NAME: "heartbeats"
{% else %}
      SITE_ROOT: "https://{{ healthchecks_hostname }}"
      SITE_NAME: "{{ cloudflare_zone }} heartbeats"
{% endif %}
      # 127.0.0.1 is not decoration. Django matches ALLOWED_HOSTS against the
      # literal Host header, and every host-side consumer dials the loopback
      # publish below BY IP: gatus-sync (HEALTHCHECKS_API_URL), the clamav
      # watchdog and the mail canary (HEALTHCHECKS_LOOPBACK_PORT). With only
      # "localhost" in this list all three got 400 DisallowedHost -- verified
      # against healthchecks/healthchecks:v4.3 directly: Host 127.0.0.1 -> 400,
      # Host localhost -> 401 (reached the app). Two watchdogs and the panel's
      # check summary were failing in a way that looks exactly like "nothing to
      # report".
{% if catena_public_surface_deferred | default(false) | bool %}
      ALLOWED_HOSTS: "{{ healthchecks_network_alias }},localhost,127.0.0.1"
{% else %}
      ALLOWED_HOSTS: "{{ healthchecks_hostname }},{{ healthchecks_network_alias }},localhost,127.0.0.1"
{% endif %}
      SECRET_KEY: "{{ healthchecks_secret_key }}"
      DEBUG: "False"
      # Closed registration -- oauth2-proxy + Keycloak gate the UI, and our seed
      # task (scripts/healthchecks-seed.py, step 0) creates the operator
      # superuser + default Project on first converge. SUPERUSER_EMAIL
      # and SUPERUSER_PASSWORD below are INERT to this image's
      # entrypoint (upstream runs migrations only, no auto-bootstrap);
      # they're kept here for visibility/parity so the expected
      # superuser credentials are discoverable on the running container.
      REGISTRATION_OPEN: "False"
      SUPERUSER_EMAIL: "{{ admin_email }}"
      SUPERUSER_PASSWORD: "{{ healthchecks_superuser_password }}"
      # PING_KEY is set here for convention/visibility, but Healthchecks
      # actually routes auto-provisioning against Project.ping_key in the
      # DB -- not this env var. The seed task in healthchecks.yml writes
      # the same value into Project.ping_key. Keep this line so future
      # tooling that expects PING_KEY to be present sees it.
      # Auto-provision URL: /ping/<ping_key>/<slug>?create=1 (the ?create=1
      # is required -- without it, unknown slugs 404).
      PING_KEY: "{{ healthchecks_ping_key }}"
      DB: "sqlite"
      DB_NAME: "/data/hc.sqlite"
      # Mail goes out through the outgoing mail chosen in Settings > Mail
      # (infrastructure_smtp), to the admin email channel healthchecks-seed.py
      # keeps. Always STARTTLS on the port given, as every sender on the host.
      # Mail turned off leaves EMAIL_HOST empty, which gives Healthchecks no
      # mailer, and the seed removes the email channel. The password is JSON-
      # quoted and its `$` doubled, so `docker stack deploy` interpolates
      # nothing out of it.
{% if infrastructure_smtp.enabled | bool %}
      EMAIL_HOST: "{{ infrastructure_smtp.host }}"
      EMAIL_PORT: "{{ infrastructure_smtp.port }}"
      EMAIL_HOST_USER: "{{ infrastructure_smtp.user }}"
      EMAIL_HOST_PASSWORD: {{ smtp_password | default('') | replace('$', '$$') | to_json }}
      EMAIL_USE_TLS: "True"
      EMAIL_USE_SSL: "False"
{% else %}
      EMAIL_HOST: ""
{% endif %}
      DEFAULT_FROM_EMAIL: "{{ infrastructure_smtp.sender }}"
      # ─── SSO passthrough via oauth2-proxy reverse-proxy ────────────
      # The per-app oauth2-proxy container in front of healthchecks
      # injects X-Forwarded-Email on every authenticated request
      # (--pass-user-headers=true in reconcile/roles/oauth2_proxy
      # templates/oauth2-proxy.compose.yml.j2), replacing any copy the
      # browser sent. Django WSGI-env-ifies headers as
      # HTTP_X_FORWARDED_EMAIL. REMOTE_USER_HEADER makes Healthchecks take
      # it as the signed-in user, on every request, from whoever sends it:
      # it logs in the account with that email and creates one when none
      # exists. SUPERUSER_EMAIL equals ADMIN_EMAIL, so the admin lands in
      # the seeded account and skips the Healthchecks login page.
      #
      # Healthchecks cannot tell the gate from any other caller, so the
      # network decides who may call it: it is on healthchecks_network
      # alone, which its gate and the services that read or ping it join
      # and no client app does (playbooks/group_vars/all/main.yml).
      REMOTE_USER_HEADER: "HTTP_X_FORWARDED_EMAIL"
    volumes:
      - healthchecks-data:/data
    # Host-mode publish so the host-side consumers can reach /api/v3/checks/
    # on {{ healthchecks_host_localhost_port }}: gatus-sync, the clamav
    # watchdog and the mail canary all dial it by IP, which is why
    # ALLOWED_HOSTS above carries 127.0.0.1.
    #
    # Long syntax with mode: host is mandatory -- the short form deploys as
    # an INGRESS publish under swarm. No host_ip: swarm's PortConfig has no
    # host-IP field and `docker stack deploy` REFUSES the key rather than
    # ignoring it, so the bind is 0.0.0.0 and the port is DECLARED
    # scope=loopback in the public-port registry, which is what denies it
    # off-box.
    ports:
      - target: {{ healthchecks_internal_port }}
        published: {{ healthchecks_host_localhost_port }}
        protocol: tcp
        mode: host
    networks:
      {{ healthchecks_network }}:
        aliases:
          - {{ healthchecks_network_alias }}
    labels:
      # FALSE on purpose -- see the note in gatus.compose.yml.j2.
      - traefik.enable=false
      # Auth posture, pinned as in gatus.compose.yml.j2.
      - vps.auth.mode=private
      - vps.auth.groups=staff

volumes:
  healthchecks-data:

networks:
  # Created by reconcile/roles/swarm before this deploys.
  {{ healthchecks_network }}:
    external: true
