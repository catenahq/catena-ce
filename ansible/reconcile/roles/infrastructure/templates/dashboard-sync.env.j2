# {{ ansible_managed }}
# Config for /usr/local/bin/dashboard-sync. This file is 0600 root:root --
# it contains the Portainer API key and the marketplace token.
#
# dashboard-sync reads every client app's deployed swarm services, writes the
# app intent the catena-admin Apps tab reads (/var/lib/catena/app-intent.json,
# catena-admin payload/lib/app_intent.py), and writes a Traefik route file for
# every routed app. Always on -- no opt-out flag (ungated = fully public).
PORTAINER_API_BASE={{ portainer_api_base_onbox }}
PORTAINER_API_KEY={{ portainer_api_key }}

# Per-app posture comes from the route service's vps.auth.* labels:
#   - public     -> one router, force-https only, straight to the app
#   - otherwise  -> one router to the app's own oauth2-proxy instance
# The middleware below is defined in
# reconcile/roles/oauth2_proxy/templates/oauth2-proxy-middlewares.yml.j2.
TRAEFIK_DYNAMIC_DIR={{ traefik_dynamic_dir }}
AUTH_HOSTNAME={{ keycloak_hostname }}
AUTH_FORCE_HTTPS_MW=oauth2-force-https-proto

# --- Per-app oauth2-proxy provisioning (default-deny enforcement) ---
# dashboard-sync provisions ONE oauth2-proxy instance per gated client
# app in a dedicated `oauth2-proxy-clients` Portainer stack (the infra
# proxies stay Ansible-managed in the `oauth2-proxy` compose). The flags
# mirror reconcile/roles/oauth2_proxy/templates/oauth2-proxy.compose.yml.j2,
# differing in --allowed-group (from the app's vps.auth.groups), --upstream
# and the session cookie: the client apps' proxies share one cookie for the
# whole domain (OAUTH2_PROXY_COOKIE_NAME and _SECRET below), while each infra
# proxy keeps a cookie of its own on its host.
CLOUDFLARE_ZONE={{ cloudflare_zone }}
# Multi-domain: every domain this host serves, primary first
# (playbooks/tasks/served_zones.yml), and the auth coordinates
# clients_provisioner islands a secondary-domain app's oauth2-proxy on: its own
# auth.<zone> issuer and cookie secret. On a single-domain host the list is the
# primary alone, so every app takes the primary path (the env values below).
#
# The two JSON values are single-quoted. systemd's EnvironmentFile and a shell
# sourcing this file (the gated-app verifier, the reconciler's diagnostic run)
# both read a single-quoted value verbatim; a shell splits an unquoted one at
# its first space and runs the rest as a command.
{% set _zones = ([cloudflare_zone] + catena_secondary_zones) | select | list %}
CLOUDFLARE_ZONES='{{ _zones | to_json }}'
AUTH_SUBDOMAIN={{ keycloak_subdomain | default('auth') }}
KEYCLOAK_REALM={{ keycloak_realm }}
OAUTH2_PROXY_CLIENTS_COMPOSE=oauth2-proxy-clients
OAUTH2_PROXY_IMAGE={{ oauth2_proxy_image }}
OAUTH2_PROXY_INTERNAL_PORT={{ oauth2_proxy_internal_port }}
OAUTH2_PROXY_COOKIE_NAME={{ oauth2_proxy_cookie_name }}
OAUTH2_PROXY_OIDC_ISSUER={{ oauth2_proxy_oidc_issuer }}
# Explicit endpoints so client-app proxies skip boot-time OIDC discovery
# (a public CF-tunnel GET that crashloops on a tunnel re-register during
# a restore). login stays PUBLIC (browser); token + JWKS go intra-cluster.
# Mirrors reconcile/roles/oauth2_proxy/templates/oauth2-proxy.compose.yml.j2.
OAUTH2_PROXY_LOGIN_URL={{ oauth2_proxy_login_url }}
OAUTH2_PROXY_REDEEM_URL={{ oauth2_proxy_redeem_url }}
OAUTH2_PROXY_JWKS_URL={{ oauth2_proxy_jwks_url }}
OAUTH2_PROXY_CLIENT_ID={{ oauth2_proxy_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ oauth2_proxy_client_secret }}
OAUTH2_PROXY_COOKIE_SECRET={{ oauth2_proxy_cookie_secret }}
{% set _zcs = {} %}
{% for _z in catena_secondary_zones %}
{%   set _slug = _z | lower | regex_replace('[^a-z0-9]+', '_') | regex_replace('^_+', '') | regex_replace('_+$', '') %}
{%   set _sec = lookup('vars', 'oauth2_proxy_cookie_secret_' ~ _slug, default='') %}
{%   if _sec | length > 0 %}{% set _ = _zcs.update({_z: _sec}) %}{% endif %}
{% endfor %}
# The secondary domains' oauth2-proxy cookie secrets, minted per domain by
# helpers/onbox_config.py. {} on a single-domain host, where the primary uses
# OAUTH2_PROXY_COOKIE_SECRET above.
OAUTH2_PROXY_ZONE_COOKIE_SECRETS='{{ _zcs | to_json }}'

# --- Keycloak redirect-URI sync (manage-clients service account) ---
# dashboard-sync UNIONs each gated client host's /oauth2/callback into
# the shared oauth2-proxy client's redirectUris (never removes), using a
# client-credentials token from the `dashboard-sync` service account
# (scoped to realm-management:manage-clients). Empty secret => the sync
# is skipped (the client app's login fails until the operator adds the
# key + re-converges); everything else still provisions.
#
# Both go to catena-admin on its published loopback port, which forwards the
# realm's token endpoint and the admin calls dashboard-sync makes to Keycloak on
# the overlay, under the public auth hostname: dashboard-sync runs on the host,
# keycloak-server resolves only inside the overlay, and Keycloak publishes no
# port. The panel admits them on CATENA_MARKETPLACE_TOKEN below; the calls bring
# their own service-account credentials.
KEYCLOAK_TOKEN_URL=http://127.0.0.1:{{ catena_admin_ui_port }}/keycloak/realms/{{ keycloak_realm }}/protocol/openid-connect/token
KEYCLOAK_CLIENTS_API=http://127.0.0.1:{{ catena_admin_ui_port }}/keycloak/admin/realms/{{ keycloak_realm }}/clients
DASHBOARD_SYNC_CLIENT_ID=dashboard-sync
DASHBOARD_SYNC_CLIENT_SECRET={{ dashboard_sync_client_secret | default('') }}

# --- Env reconcile after a rotation or a domain change (managed_env) ---
# What each template's reconcilable values SHOULD be on this host, answered by
# catena-admin so there is one evaluator of the catalog's expressions rather
# than a second one here. Empty => nothing to reconcile against and the lane
# no-ops, which is what a host with no marketplace wired has. Loopback on the
# panel's published port, because dashboard-sync runs on the host, and the
# service name the App Templates URL uses resolves only inside the overlay.
CATENA_MANAGED_ENV_URL={% if catena_marketplace_token | default('') | length > 0 %}http://127.0.0.1:{{ catena_admin_ui_port }}/marketplace/managed-env.json{% endif %}

# The marketplace token, the same one the App Templates URL carries, because
# the managed env is a list of this host's live credentials. dashboard-sync
# sends it in a request header to the two routes above; no URL here carries it,
# so an error that prints one prints no secret.
CATENA_MARKETPLACE_TOKEN={{ catena_marketplace_token | default('') }}
