{{ ansible_managed | comment }}
# Sourced by /usr/local/bin/catena-heartbeat (catena-admin payload): the
# loopback ports of the three monitors it probes, and its own check on this
# host's Healthchecks. The off-site address is not here: the lane reads it off
# /etc/catena/config.json on every run, so a Settings save needs no converge.
GATUS_LOOPBACK_PORT={{ gatus_host_localhost_port }}
HEALTHCHECKS_LOOPBACK_PORT={{ healthchecks_host_localhost_port }}
BESZEL_LOOPBACK_PORT={{ beszel_hub_host_localhost_port }}
HC_PING_KEY={{ healthchecks_ping_key | default('') }}
HEARTBEAT_CHECK_SLUG={{ heartbeat_check_slug }}
