# catena: client-editable, non-secret configuration.
#
# GENERATED from catena-ce/ansible/helpers/knobs.yml. To change a key or its
# explanation, edit that file and run `python3 helpers/render_knobs.py
# --write`; an edit made here is replaced by the next render, and fails the
# CI check until then.
#
# Copy it to `.env` inside a host directory (gitignored), one per inventory
# so several hosts coexist in one checkout: inventory/example/.env,
# inventory/clientco/.env. Ansible resolves <inventory_dir>/.env through the
# `dotenv` lookup plugin at playbooks/lookup_plugins/, and group_vars reads
# a value with "{{ lookup('dotenv', 'KEY') }}".
#
# No secret belongs in here, or anywhere else in an inventory. Every secret
# lives on the target at /etc/catena/config.json, minted there or entered in
# catena-admin > Settings. See catena-ce/SECRETS.md.

# --- Host -------------------------------------------------------------------
#
# Where the box is and how the first SSH lands on it, before the ops account
# exists and before the firewall closes.

# The provider's public IPv4. Used during bootstrap, before the firewall
# closes and the box is reached another way.
HOST_PUBLIC_IP=203.0.113.10

# The provider's default login for that same phase (root, ubuntu, debian,
# ec2-user). Not OPS_USER -- that account does not exist yet.
HOST_INITIAL_USER=root

# The port the controller CONNECTS on, written into hosts.yml as
# ansible_port. The firewall rules name 22 literally, so a value here moves
# what the controller dials and not what the host opens.
HOST_SSH_PORT=22

# --- SSH --------------------------------------------------------------------
#
# Generate the pair once:
#
#     ssh-keygen -t ed25519 -f ~/.ssh/catena_ed25519 -C catena

# A dedicated keypair for this project, so revoking at engagement end is
# throwing away one file. The installer offers to generate it when absent.
SSH_PRIVATE_KEY=~/.ssh/catena_ed25519

SSH_PUBLIC_KEY_FILE=~/.ssh/catena_ed25519.pub

# The non-root account created on every VPS, authorized for the key above.
OPS_USER=ops

# --- Private network --------------------------------------------------------
#
# Every host joins a private network before anything else is reachable. One
# method, two providers: Tailscale SaaS or a self-hosted Headscale.
#
# The three keys below SEED the on-box store on the first converge and are
# never read again. After the install the choice lives in catena-admin >
# Settings > Access and tunnels, which is where a client changes it; editing
# them here afterwards changes nothing.
#
# Tailscale SaaS: leave all three blank. `catena install` prints the
# one-time admin-console steps, then prompts for the OAuth client id and
# secret. Headscale: set TAILNET_PROVIDER=headscale and fill the two below
# it; `catena install` prompts instead for a headscale_api_key (preferred, a
# short-lived tagged pre-auth key is minted per run) or a static
# headscale_preauth_key.
#
# Either credential is asked for at install rather than in the panel,
# because it is what JOINS the host to the tailnet and the panel is
# published on that tailnet. Rotating it later is a Settings job; supplying
# it the first time cannot be.

# Comma-separated tags advertised by each node. Every tag must be authorized
# on the control server first, or key minting rejects with a 400. Read with
# NO default, so a missing key fails the lookup rather than falling back to
# a tag the credential is not scoped for.
TAILSCALE_TAGS=tag:vps

# Whether Tailscale may override systemd-resolved. Usually false.
TAILSCALE_ACCEPT_DNS=false

# The whole routing decision. Blank means Tailscale SaaS. Explicit rather
# than inferred from whether a control URL happens to be filled in: that
# inference made "switch back to Tailscale" mean "know to CLEAR a field",
# and a blank submission on the settings page means "leave this alone", so
# the client could make that decision in one direction only.
TAILNET_PROVIDER=

# The Headscale server's base URL.
TAILNET_CONTROL_URL=

# The Headscale user the minted pre-auth keys belong to; Headscale keys are
# per-user, and the advertised tag must be in THAT user's tagOwners.
HEADSCALE_USER=

# --- Cloudflare -------------------------------------------------------------

# THE identity of the install: every public hostname is <sub>.<zone>, so
# this is the value the rest of the page renders against. Blank is a real
# state -- a server is installed before its domain is decided, and the
# public surface defers until one arrives.
CLOUDFLARE_ZONE=

# The one subdomain three sources give three answers for -- `portainer` in
# the shipped starter, `apps` in the operator skeleton, `admin` for
# established clients -- which is what makes it a host fact rather than the
# product's. The rest are the product's scheme and are compiled in, because
# a host has to converge itself without reading this file.
PORTAINER_SUBDOMAIN=portainer

# Prefixes the name of the tunnel a host creates. Blank leaves each host
# owning one tunnel named after its inventory hostname; a prefix of "corp-"
# on a host named "vps1" names the tunnel "corp-vps1". A store key because
# the host composes its own tunnel name and reads the prefix straight off
# the store, which is what lets the cloudflared actions ship in the image
# instead of being rendered by a converge.
CLOUDFLARED_TUNNEL_NAME_PREFIX=

# --- Admin identity ---------------------------------------------------------

# One address for the Portainer admin and the initial realm admin. The
# matching password is minted on the box and shown once at the end of the
# install, with the first-login URLs. A host fact by any reading, which is
# why the `.env` only seeds it.
ADMIN_EMAIL=operator@example.com

# --- Storage ----------------------------------------------------------------
#
# The primary disk holds app data and the Docker data-root under one prefix,
# which the backup set, the volume layout and the restore machine all name.

# built_in carves directories on the root disk; attached formats and mounts
# a separate block device.
# One of: built_in, attached.
STORAGE_MODE=built_in

# Read only when STORAGE_MODE is attached.
STORAGE_BLOCK_DEVICE=/dev/sdb

# A separate optional tier over CIFS or NFS, independent of the primary
# disk. Append-only data only: never database storage, never the Docker
# data-root.
STORAGE_BULK_ENABLED=false

STORAGE_BULK_MOUNT_POINT=/mnt/bulk

# --- Site policy ------------------------------------------------------------

# Optional apt HTTP proxy, typically an apt-cacher-ng. Blank pulls direct.
# HTTPS sources stay direct either way. A site policy rather than an install
# input.
APT_PROXY_URL=

# Optional pull-through mirror, as a base URL with scheme, host and port.
# Blank pulls from docker.io directly.
DOCKER_REGISTRY_MIRROR_URL=

# --- Locale and timezone ----------------------------------------------------

COMMON_TIMEZONE=America/Toronto

COMMON_LOCALE=en_CA.UTF-8

# --- Development only -------------------------------------------------------
#
# Leave every key in this section at its default on a client install. They
# point certificate issuance at a local Pebble or at Let's Encrypt staging,
# whose certificates browsers, TURN clients and sending MTAs all reject. The
# test bench sets them to its own host-side ACME server.

# Issue the coturn TLS-TURN certificate from Let's Encrypt's staging CA.
# Staging has no rate limit and coturn only validates presence and expiry.
COTURN_CERTBOT_STAGING=false

# The same, for the self-hosted mailserver's mail.<zone> certificate.
MAILSERVER_CERTBOT_STAGING=false

# A local ACME server's directory endpoint. Blank issues against Let's
# Encrypt as normal.
CATENA_ACME_DIRECTORY_URL=

# Mapped to the hostname `pebble` in /etc/hosts, Pebble's endpoint-cert SAN.
CATENA_ACME_HOST_IP=

# Base64 because a raw multi-line PEM cannot live in a `.env`.
CATENA_ACME_CA_BUNDLE_PEM_B64=
