# ─── catena: operator-editable, non-secret configuration ──────────────
#
# Copy and rename to .env in your host directory (gitignored) and fill in. Per-inventory
# so multiple hosts can coexist in one checkout: inventory/example/.env,
# inventory/clientco/.env, etc.
# No secret goes in here, or anywhere else in this inventory: every
# secret lives on the target at /etc/catena/config.json, minted there or entered
# in catena-admin > Settings. See catena-ce/SECRETS.md.
#
# This file is loaded by Ansible via the custom `dotenv` lookup plugin at playbooks/lookup_plugins/,
# which resolves <inventory_dir>/.env automatically.
# Group_vars reference values with  "{{ lookup('dotenv', 'KEY') }}".

# ─── Host ─────────────────────────────────────────────────────────────────
# The VPS provider's public IPv4. Used only during bootstrap, before port 22
# closes and the box becomes reachable over the tailnet instead.
HOST_PUBLIC_IP=203.0.113.10
# The provider's default login for that same bootstrap phase (root, ubuntu,
# debian, ec2-user...). Not OPS_USER below -- that account doesn't exist yet.
HOST_INITIAL_USER=root
HOST_SSH_PORT=22

# ─── SSH ──────────────────────────────────────────────────────────────────
# Dedicated Ed25519 keypair for this project (generate once on your laptop):
#     ssh-keygen -t ed25519 -f ~/.ssh/catena_ed25519 -C catena
SSH_PRIVATE_KEY=~/.ssh/catena_ed25519
SSH_PUBLIC_KEY_FILE=~/.ssh/catena_ed25519.pub

# Non-root user created on every VPS. Your public key is authorized for it.
OPS_USER=ops

# ─── Private network: Tailscale SaaS or self-hosted Headscale ──────────────
# Every VPS joins this network before anything else is reachable. Pick ONE.
#
# Tailscale SaaS (default): leave BOTH fields below BLANK. `catena install`
# prints the one-time admin-console setup steps and then prompts for the
# OAuth client id + secret (hidden input); they are adopted on-box and
# nothing persists on this machine or in this inventory.
#
# Self-hosted Headscale: FILL BOTH fields below. TAILNET_CONTROL_URL is the
# Headscale server's base URL; HEADSCALE_USER is the Headscale user the
# pre-auth keys belong to. No OAuth client -- Headscale has no OAuth API --
# so `catena install` prompts instead for ONE of: headscale_api_key
# (preferred; the converge mints a short-lived tagged pre-auth key per run
# from it, leaving nothing long-lived on the VPS) or a static
# headscale_preauth_key. Like the Tailscale pair, it is adopted on-box and
# nothing persists on this machine. tag:vps must be in THAT user's ACL
# tagOwners in Headscale's own policy file.
#
# It is asked for at install, not in catena-admin > Settings, because it is
# what JOINS the VPS to the tailnet -- and the panel is published on that
# tailnet. Rotating it later is a Settings job; supplying it the first time
# cannot be.
TAILNET_CONTROL_URL=
HEADSCALE_USER=

# ─── Tailnet join options (apply to either backend above) ──────────────────
# Comma-separated tags advertised by each VPS. tag:vps is required. Every tag
# listed here must be authorized on the control server first -- `catena
# install` prints the exact steps for Tailscale SaaS; on Headscale, add the
# tag to HEADSCALE_USER's tagOwners in the policy file.
TAILSCALE_TAGS=tag:vps

# Let Tailscale override systemd-resolved? Usually false -- we keep control of DNS.
TAILSCALE_ACCEPT_DNS=false

# ─── Cloudflare ────────────────────────────────────────────────────────
# The main domain under which the catena apps and their subdomains will run.
CLOUDFLARE_ZONE=example.com

# Optional prefix prepended to every Cloudflare tunnel name. Default empty --
# each host owns one tunnel named after its inventory hostname. Example: a
# prefix of "corp-" on a host named "vps1" names the tunnel "corp-vps1".
CLOUDFLARED_TUNNEL_NAME_PREFIX=

# Public subdomains under CLOUDFLARE_ZONE, all SSO-gated (Keycloak +
# oauth2-proxy) except AUTH_SUBDOMAIN itself, which IS the SSO login page.
# Portainer: self-serve app deploys (admin-only)
PORTAINER_SUBDOMAIN=portainer
# Gatus: live probes + public status page
GATUS_SUBDOMAIN=monitor
# catena-admin: per-VPS admin panel (Apps / System / Actions / Recovery)
DASH_SUBDOMAIN=dash
# Healthchecks: cron / dead-man monitoring
HEARTBEAT_SUBDOMAIN=heartbeat
# Keycloak SSO login page; clients log in here once, forwarded to the
# subdomains above via oauth2-proxy.
AUTH_SUBDOMAIN=auth
# Beszel: resource monitor hub (CPU/memory/network/disk history + alerts)
BESZEL_SUBDOMAIN=hub

# ─── Admin identity (shared by Portainer + Keycloak) ──────────────────────
# Single email used for both the Portainer admin account and the initial
# Keycloak realm admin. The matching password is minted on the box and shown
# ONCE at the end of install, alongside the first-login URLs -- save it.
ADMIN_EMAIL=operator@example.com

# ─── Storage ────────────────────────────────────────────────────────────
# Primary disk. built_in = the VPS's own SSD (default). attached = a
# separate block volume (OVH Public Cloud, Hetzner Volume, DO Block
# Storage). This is where app data + the Docker data-root live.
STORAGE_MODE=built_in
STORAGE_MOUNT_POINT=/mnt/data
# Only used when STORAGE_MODE=attached.
STORAGE_BLOCK_DEVICE=/dev/sdb
#
# Bulk is a SEPARATE, optional, additional tier over CIFS/NFS (Hetzner
# Storage Box, client NAS) -- runs regardless of STORAGE_MODE above. For
# append-only data only (media, archives); never DB storage or Docker data.
STORAGE_BULK_ENABLED=false
STORAGE_BULK_MOUNT_POINT=/mnt/bulk

# ─── Docker ──────────────────────────────────────────────────────────────
# Optional pull-through Docker Hub mirror. Empty = pull from docker.io
# directly. Set to a mirror base URL (scheme + host + port) to route pulls
# through a cache.
DOCKER_REGISTRY_MIRROR_URL=

# ─── Apt cache ───────────────────────────────────────────────────────────
# Optional apt HTTP proxy (typically apt-cacher-ng). Empty = apt pulls direct.
# Set to the proxy URL (e.g. http://10.0.0.1:3142) to route HTTP apt traffic
# through it. HTTPS sources (docker-ce, tailscale) stay direct.
APT_PROXY_URL=

# ─── Locale / timezone ───────────────────────────────────────────────────
COMMON_TIMEZONE=America/Toronto
COMMON_LOCALE=en_CA.UTF-8

# ─── coturn TLS cert source (development only) ────────────────────────────
# Issue the coturn TLS-TURN cert from Let's Encrypt's STAGING CA when true.
# Staging has no rate limit and is functionally identical for coturn (which
# only validates presence + expiry). NEVER set true in production -- browsers
# and TURN clients reject staging certs.
COTURN_CERTBOT_STAGING=false

# ─── mailserver TLS cert source (development only) ────────────────────────
# Same as COTURN_CERTBOT_STAGING, for the self-hosted mailserver's mail.<zone>
# cert. NEVER set true in production -- sending MTAs reject staging certs and
# deliverability breaks.
MAILSERVER_CERTBOT_STAGING=false

# ─── local ACME server (development only) ────────────────────────────────
# Leave ALL of these blank in production -- the mailserver + coturn cert
# tasks then issue against Let's Encrypt as normal. The test bench sets
# them to its host-side Pebble ACME server so cert issuance does not
# depend on LE staging. CATENA_ACME_HOST_IP is mapped to the hostname
# `pebble` (Pebble's endpoint-cert SAN) in /etc/hosts; the CA bundle is
# base64-encoded because a raw multi-line PEM cannot live in a .env.
CATENA_ACME_DIRECTORY_URL=
CATENA_ACME_HOST_IP=
CATENA_ACME_CA_BUNDLE_PEM_B64=
