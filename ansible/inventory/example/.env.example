# ─── catena: operator-editable, non-secret configuration ──────────────
#
# Copy to .env in this same directory (gitignored) and fill in. Per-inventory
# so multiple hosts can coexist in one checkout: inventory/example/.env,
# inventory/clientco/.env, etc.
# NO secret goes in here, or anywhere else in this inventory (0b): every
# secret lives on the box at /etc/catena/config.json, minted there or entered
# in catena-admin > Settings. See ../../SECRETS.md.
# Inventory (VPS IPs, tailnet hostnames) lives in inventory/<name>/hosts.yml.
#
# Loaded by Ansible via the custom `dotenv` lookup plugin at playbooks/lookup_plugins/,
# which resolves <inventory_dir>/.env automatically.
# Group_vars reference values with  "{{ lookup('dotenv', 'KEY') }}".

# ─── SSH ──────────────────────────────────────────────────────────────────
# Dedicated Ed25519 keypair for this project (generate once on your laptop):
#     ssh-keygen -t ed25519 -f ~/.ssh/catena_ed25519 -C catena
SSH_PRIVATE_KEY=~/.ssh/catena_ed25519
SSH_PUBLIC_KEY_FILE=~/.ssh/catena_ed25519.pub

# Non-root user created on every VPS. Your public key is authorized for it.
OPS_USER=ops

# ─── Client-facing language default ────────────────────────────────────────
# Applies to the docs wiki, catena-admin, and Keycloak login UI. Values: en | fr.
CATENA_DEFAULT_LANGUAGE=en

# ─── Tailscale ────────────────────────────────────────────────────────────
# Comma-separated tags advertised by each VPS. tag:vps is required (the OAuth
# client is scoped to it). To add more tags you MUST first authorize them in
# BOTH places, otherwise the OAuth API rejects key minting with a 400:
#   1. Tailscale admin console -> Access controls -> tagOwners -> add the tag
#   2. Tailscale admin console -> Settings -> OAuth client -> add the tag to scope
TAILSCALE_TAGS=tag:vps

# Let Tailscale override systemd-resolved? Usually false -- we keep control of DNS.
TAILSCALE_ACCEPT_DNS=false

# ─── Control server (Tailscale SaaS or self-hosted Headscale) ──────────────
# Leave TAILNET_CONTROL_URL empty for Tailscale SaaS (the default OAuth join).
# Set it to a Headscale base URL to join a self-hosted control server instead;
# Headscale has no OAuth API, so the node joins with a pre-auth key. Provide a
# credential in the on-box store: headscale_api_key (preferred -- the
# converge mints a short-lived tagged key per run, so no long-lived key on the
# VPS) or headscale_preauth_key (a static key you create). Minting also
# needs HEADSCALE_USER (the Headscale user the key belongs to). tag:vps must be
# in that user's ACL tagOwners for --advertise-tags to succeed.
TAILNET_CONTROL_URL=
HEADSCALE_USER=

# ─── Cloudflare ────────────────────────────────────────────────────────
# The Cloudflare API TOKEN is NOT set here (or anywhere in the inventory) --
# it is entered only in catena-admin > Settings, which writes it to the on-box
# store. The tunnel stays deferred until then, so a token-less install is the
# normal path, not a special mode.
CLOUDFLARE_ZONE=example.com
# Optional: leave blank. The host engine (catena-cloudflared-sync) resolves the
# account id from the token and persists it to the on-box store on first sync.
CLOUDFLARE_ACCOUNT_ID=

# Public-facing subdomains, joined with CLOUDFLARE_ZONE. All gated by
# self-hosted SSO + forward-auth (Keycloak + oauth2-proxy); SSO works across
# them via the shared *.<zone> cookie.
#   portainer.<zone> -> Portainer (self-serve app deploys; admin-only)
#   monitor.<zone>   -> Gatus (live probes + public status page)
#   dash.<zone>      -> catena-admin (per-VPS admin panel: Apps / System /
#                       Actions / Recovery; runs the host dispatcher)
#   heartbeat.<zone> -> Healthchecks (cron / dead-man monitoring)
PORTAINER_SUBDOMAIN=portainer
MONITOR_SUBDOMAIN=monitor
DASH_SUBDOMAIN=dash
HEARTBEAT_SUBDOMAIN=heartbeat
# Keycloak SSO lives at AUTH_SUBDOMAIN.<zone>. Clients log in here once;
# SSO-forwarded to the subdomains above via oauth2-proxy.
AUTH_SUBDOMAIN=auth

# Optional prefix prepended to every Cloudflare tunnel name. Default empty --
# each host owns one tunnel named after its inventory hostname.
CLOUDFLARED_TUNNEL_NAME_PREFIX=

# ─── Admin identity (shared by Portainer + Keycloak) ──────────────────────
# Single email used for both the Portainer admin account and the initial
# Keycloak realm admin. The matching password is minted on the box and shown
# ONCE at the end of install -- save it. First-login URLs:
#   - Portainer: https://portainer.<zone>   (or PORTAINER_SUBDOMAIN)
#   - Keycloak:  https://auth.<zone>
ADMIN_EMAIL=operator@example.com

# ─── SMTP (outbound mail for Keycloak: password reset, invites, MFA) ──────
# Three modes -- pick ONE (or leave all blank to deploy without mail).
#
# Mode A (Resend, recommended). Sign up at resend.com, verify your sending
# domain (add DKIM/SPF/DMARC in Cloudflare), generate ONE API key (re_...).
# Store it in smtp_password -- it doubles as the SMTP password. Set only
# the sender email below; the role auto-resolves host/port/user
# (smtp.resend.com:587, user=resend). Free tier: 100/day, 3000/month.
RESEND_SENDER_EMAIL=
#
# Mode B (Brevo). Higher daily volume (300/day, 9k/month free). Requires the
# Brevo SMTP key (NOT the v3 API key) in smtp_password. Only set the
# sender email below; host/port/user auto-resolved
# (smtp-relay.brevo.com:587, user=<the sender email>).
BREVO_SENDER_EMAIL=
#
# Mode C (manual -- any other SMTP provider or self-hosted).
# Ignored when Resend or Brevo sender is set above.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=auth@example.com
SMTP_USE_TLS=true

# ─── ntfy (alert delivery) ────────────────────────────────────────────────
# Where Healthchecks pushes alerts. Single topic per VPS, with the failing
# check name in every message.
#
# BOTH BLANK BY DEFAULT, on purpose. The default used to be https://ntfy.sh --
# a public, unauthenticated server, where the topic is the only secret and
# anyone who guesses it reads every alert this host emits. A default that
# leaks the client's operational state off-box the moment nobody edits this
# file is the wrong default; no channel is better than a public one.
#
# Blank means the converge seeds no notification channel and says so. Alerts
# are still recorded in Healthchecks -- what is missing is the push. Point
# these at your own ntfy (see internal_docs/tools/notifications.md), or
# leave them blank and let the client attach their own channel through the
# Healthchecks integrations UI, which is the intended client-side path.
#
# If you do set them: the topic MUST be hard to guess -- on any ntfy instance
# without auth, knowing the topic is the whole of the access control.
NTFY_SERVER=
NTFY_TOPIC=

# ─── Storage (roles/storage) ──────────────────────────────────────────────
# built_in = single SSD (default). attached = a block volume (OVH Public
# Cloud, Hetzner Volume, DO Block Storage, etc.).
STORAGE_MODE=built_in
STORAGE_MOUNT_POINT=/mnt/data
STORAGE_BLOCK_DEVICE=/dev/sdb
STORAGE_BULK_ENABLED=false
STORAGE_BULK_MOUNT_POINT=/mnt/bulk

# ─── Docker ──────────────────────────────────────────────────────────────
# Optional pull-through Docker Hub mirror. Empty = pull from docker.io
# directly. Set to a mirror base URL (scheme + host + port) to route pulls
# through a cache.
DOCKER_REGISTRY_MIRROR_URL=

# ─── Apt cache ───────────────────────────────────────────────────────────
# Optional apt HTTP proxy (typically apt-cacher-ng). Empty = apt pulls direct.
# Set to the proxy URL (e.g. http://10.0.0.1:3142) to route HTTP apt traffic
# through it. HTTPS sources (docker-ce, tailscale) stay direct.
APT_PROXY_URL=

# ─── Portainer (container control plane) ─────────────────────────────────
# Port the Portainer UI/API listens on (host-mode, firewalled to the
# tailnet; the public path is portainer.<zone> via the CF tunnel,
# oauth2-gated). Image pin lives in roles/portainer/defaults/main.yml.
PORTAINER_UI_PORT=9000

# ─── catena-admin (operator panel) ─────────────────────────────────────────
# Host port for the catena-admin panel's native-login listener (host-mode,
# firewalled to the tailnet + RFC1918). Reach the panel at
# http://<tailnet-ip>:<port> with the admin email + the admin password shown
# once at install -- no Cloudflare needed. In cloudflare mode the public path
# dash.<zone> (oauth2-gated) stays available too.
CATENA_ADMIN_UI_PORT=9010

# ─── Backup ───────────────────────────────────────────────────────────────
# Backup is configured POST-INSTALL, not here (0b). After the host is up, open
# catena-admin > Settings > Backup and set the restic repo URL + S3 access/
# secret keys + enable + (optional) retention. Those land in the on-box store
# and run-backup.sh reads them at runtime -- no converge. The restic encryption
# password is minted on-box and shown ONCE at the end of `catena install`; save
# it in your password manager (it is the one DR secret you must hold off-box).
# Community ships a MANUAL/weekly backup; the offsite cold mirror + sub-weekly
# cadence + tested-restore attestation are the Business managed-backup tier.
#
# These keys are OPTIONAL converge-time fallbacks (the store wins at runtime).
# Leave BACKUP_RESTIC_REPO blank to defer the whole backup config to the panel.
BACKUP_RESTIC_REPO=
# The offsite cold mirror, same seed-then-store rule as the repo above. Blank
# is a legitimate answer and means the mirror is OFF -- run-backup.sh skips it
# and says so. They are seedable here rather than panel-only because they are
# the same shape as BACKUP_RESTIC_REPO: an S3 URL the operator already knows
# at install time. Leaving them out of this file entirely made them
# unreachable at install: they are store-owned, and nothing seeded the store.
BACKUP_WORM_REPO=
NEXTCLOUD_WORM_REPO=
# Auto-rendered from the Nextcloud catalog template's Environment at converge
# time when blank; set it only to point the mirror at a different bucket.
NEXTCLOUD_LIVE_REPO=
# Optional off-host dead-man ping (whole-host-outage coverage). Empty = the
# local self-hosted Healthchecks at heartbeat.<zone> is used.
BACKUP_HEALTHCHECK_URL=

# ─── Nextcloud per-file version retention ─────────────────────────────────
# Direct lever on bucket storage cost. Default `auto, 7` keeps ~50-70% less
# storage than the upstream 30-day cap; bump to `auto, 14` / `auto, 30` for
# deeper undo. Flows through the zz-catena.sh entrypoint hook into Nextcloud's
# versions_retention_obligation on every container start.
NEXTCLOUD_VERSIONS_RETENTION=auto, 7

# ─── Locale / timezone ───────────────────────────────────────────────────
COMMON_TIMEZONE=America/Toronto
COMMON_LOCALE=en_CA.UTF-8

# ─── Beszel resource monitor ──────────────────────────────────────────────
# Hub + agent resource monitor (per-container + per-host CPU/memory/network/
# disk history with threshold alerting). Always deployed. The hub is
# published at <BESZEL_SUBDOMAIN>.<zone>, admin-gated by oauth2-proxy; the
# catena-admin Resources tab links to it. Threshold alerts ride the
# Healthchecks notification plane via the beszel-hc-shim sidecar.
BESZEL_SUBDOMAIN=hub

# ─── coturn TLS cert source ─────────────────────────────────────────
# Issue the coturn TLS-TURN cert from Let's Encrypt's STAGING CA when true.
# Staging has no rate limit and is functionally identical for coturn (which
# only validates presence + expiry). NEVER set true in production -- browsers
# and TURN clients reject staging certs.
COTURN_CERTBOT_STAGING=false

# ─── mailserver TLS cert source ─────────────────────────────────────
# Same as COTURN_CERTBOT_STAGING, for the self-hosted mailserver's mail.<zone>
# cert. NEVER set true in production -- sending MTAs reject staging certs and
# deliverability breaks.
MAILSERVER_CERTBOT_STAGING=false

# ─── local ACME server (test bench only) ────────────────────────────
# Leave ALL of these blank in production -- the mailserver + coturn cert
# tasks then issue against Let's Encrypt as normal. The test bench sets
# them to its host-side Pebble ACME server so cert issuance does not
# depend on LE staging. CATENA_ACME_HOST_IP is mapped to the hostname
# `pebble` (Pebble's endpoint-cert SAN) in /etc/hosts; the CA bundle is
# base64-encoded because a raw multi-line PEM cannot live in a .env.
CATENA_ACME_DIRECTORY_URL=
CATENA_ACME_HOST_IP=
CATENA_ACME_CA_BUNDLE_PEM_B64=
