# Managed by Ansible (roles/backup). Do not edit by hand -- changes are
# overwritten. Consumed by {{ backup_wrapper_script }} and the systemd unit.
# Mode 0600, owner root: contains S3 credentials.

RESTIC_REPOSITORY={{ backup_restic_repo }}
RESTIC_PASSWORD_FILE={{ backup_password_file }}

# S3 credentials for the restic repo (the client-owned bucket). Blank on a
# deferred-backup install: the live values come from the on-box store
# (/etc/catena/config.json), which catena-admin writes with no converge, and
# every restic caller resolves them through catena-restic-env at runtime. A
# blank here is therefore not an unconfigured host -- read the store to answer
# that. This file is written only-if-absent, so its copy can be a save behind
# and the store wins wherever it holds a value.
AWS_ACCESS_KEY_ID={{ backup_s3_access_key | default('') }}
AWS_SECRET_ACCESS_KEY={{ backup_s3_secret_key | default('') }}

# Non-secret configuration used by the wrapper.
# R24: two pings per run. _URL = success-only (sliding-grace window).
# _ATTEMPTED_URL = every run start + /fail on hard errors.
BACKUP_HEALTHCHECK_URL={{ backup_healthcheck_url }}
BACKUP_HEALTHCHECK_ATTEMPTED_URL={{ backup_healthcheck_attempted_url }}
# R13: external dead-mans pinged in parallel at end-of-run on success.
# Either, both, or neither set is valid; empty values are skipped silently
# by run-backup.sh.
BACKUP_HEALTHCHECK_URL_CLIENT={{ backup_healthcheck_url_client }}
BACKUP_HEALTHCHECK_URL_OPERATOR={{ backup_healthcheck_url_operator }}

BACKUP_PG_DUMP_USER={{ backup_pg_dump_user }}
BACKUP_STAGING_DIR={{ storage_mount_point }}/backup-staging

# R16 disk-space preflight. run-backup.sh aborts loudly (no pg_dumpall,
# no restic) if the staging mount has too little free space.
#
# This value is the FLOOR, not the requirement. At runtime the wrapper sums
# pg_database_size across every running postgres container and requires that
# instead whenever it is larger -- a fixed number sized for a reference host
# does not know when it stops being right. The scaling knob is
# BACKUP_PREFLIGHT_DB_PCT (default 100); it is deliberately NOT templated
# here, because this file is written only-if-absent and a key added to it now
# would be dead on every existing host, which is exactly the two-writers trap
# the retention note below describes.
BACKUP_PREFLIGHT_MIN_BYTES={{ backup_preflight_min_bytes }}
BACKUP_DISK_PREFLIGHT_SCRIPT={{ backup_disk_preflight_script }}

# Retention is NOT here. It lives in /etc/catena/backup-retention.env, which
# `catena-schedule apply` renders from /etc/catena/config.json, and which
# run-backup.sh sources after this file.
#
# It cannot live here: this file is written only-if-absent, on purpose, so a
# converge never overwrites a rotated credential. Retention has to be able to
# change. Templating it here meant that on any host that already had this file
# the converge's values were dead while a second copy in the config store was
# live -- two writers, one silently ignored.

# Sibling files hold list-valued config (paths + excludes) -- one item
# per line. Kept out of this env file because /bin/sh has no arrays and
# quote-packing a list into a scalar is its own footgun.
BACKUP_PATHS_FILE=/etc/catena/backup-paths
BACKUP_EXCLUDE_FILE=/etc/catena/backup-exclude-patterns

# Diagnostic outputs.
BACKUP_STATS_FILE={{ backup_stats_file }}
BACKUP_COVERAGE_SCRIPT={{ backup_coverage_script }}

# Snapshot export (catena-admin "Export latest snapshot" action).
BACKUP_EXPORT_DIR={{ backup_export_dir }}
BACKUP_EXPORT_KEEP_LAST={{ backup_export_keep_last }}
BACKUP_PASSWORD_FILE_PATH={{ backup_password_file }}
# Used only in the scp-hint line of the export script's stdout.
BACKUP_SCP_HINT_HOST={{ ansible_host | default(inventory_hostname) }}

# F6: snapshot-list helper. Renders ${BACKUP_EXPORT_DIR}/index.html
# after every backup run + every export so a copy of the export folder
# carries its own listing of the live restic repo state.
BACKUP_SNAPSHOT_LIST_SCRIPT={{ backup_snapshot_list_script }}
# Repo integrity probe. run-backup.sh calls it with --metadata after a
# successful snapshot; the bit-rot read is the separate restic_check_subset
# lane. Also read by catena-restic-check-subset.service via this same file.
BACKUP_RESTIC_CHECK_SCRIPT={{ backup_restic_check_script }}
BACKUP_RESTIC_CHECK_TIMEOUT={{ backup_restic_check_timeout }}
# Surfaced in the rendered page's "Need a download?" callout. Dotted
# back through the env file so the script doesn't need a separate
# discovery path.
CLOUDFLARE_ZONE={{ cloudflare_zone | default('') }}
