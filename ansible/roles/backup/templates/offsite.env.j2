{{ ansible_managed | comment }}
# Dead-man endpoints for the offsite-copy lane.
#
# catena-offsite-copy.service loads this with a leading dash, so a host without
# it starts the unit and the lane simply pings nothing. That is the fail-soft
# contract -- and it is also how the previous form of this file went missing
# without anyone noticing: nothing rendered it, every run reported "WORM
# unconfigured, skipping", and the offsite immutable copy never happened on any
# real host.
#
# Separate from backup.env next door for one reason: backup.env is written
# only-if-absent so a converge never clobbers a rotated credential, and a file
# that is never rewritten cannot carry configuration that changes. Same
# reasoning that moved retention out to backup-retention.env.
#
# WHICH buckets are copied is NOT here. That is the `offsite_copies` list in
# /etc/catena/config.json, written by catena-admin and read straight off disk by
# the lane, so adding a copy takes effect on the next run with no converge in
# between.
#
# One pair of checks for the whole lane, not one per copy: a check that appears
# and disappears as a client edits the list is a monitoring surface that churns,
# and the run's single signal already names the copies it is about.

OFFSITE_HEALTHCHECK_URL={{ offsite_healthcheck_url }}
OFFSITE_HEALTHCHECK_ATTEMPTED_URL={{ offsite_healthcheck_attempted_url }}
