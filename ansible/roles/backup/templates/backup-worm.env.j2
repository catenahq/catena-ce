{{ ansible_managed | comment }}
# Cold-tier (WORM) coordinates for the two mirror lanes.
#
# catena-restic-mirror.service and catena-nextcloud-mirror.service load this
# with a leading dash, so a host without it starts the unit and the engine
# skips cleanly. That is the fail-soft contract -- and it is also how the file
# went missing without anyone noticing: nothing rendered it, every mirror run
# reported "WORM unconfigured, skipping", and the offsite immutable copy never
# happened on any real host.
#
# Separate from backup.env next door for one reason: backup.env is written
# only-if-absent so a converge never clobbers a rotated credential, and a file
# that is never rewritten cannot carry configuration that changes. Same
# reasoning that moved retention out to backup-retention.env.
#
# Every value is legitimately blank on a host with no cold tier. Blank means
# skip, not fail: a misconfigured WORM must never brick the primary backup.

# Restic repo mirror: the live repo (from backup.env) is synced to this one.
BACKUP_WORM_REPO={{ backup_worm_repo }}
BACKUP_WORM_ACCESS_KEY_ID={{ backup_worm_access_key | default('') }}
BACKUP_WORM_SECRET_ACCESS_KEY={{ backup_worm_secret_key | default('') }}
BACKUP_WORM_HEALTHCHECK_URL={{ backup_worm_healthcheck_url }}
BACKUP_WORM_HEALTHCHECK_ATTEMPTED_URL={{ backup_worm_healthcheck_attempted_url }}

# Nextcloud primary-bucket mirror. The live coordinates are the same bucket
# and the same IAM user Nextcloud itself uses; the worm half is a second
# provider with Object Lock. Blank live repo means no Nextcloud on this host.
NEXTCLOUD_LIVE_REPO={{ nextcloud_live_repo }}
NEXTCLOUD_LIVE_ACCESS_KEY_ID={{ nextcloud_s3_access_key | default('') }}
NEXTCLOUD_LIVE_SECRET_ACCESS_KEY={{ nextcloud_s3_secret_key | default('') }}
NEXTCLOUD_WORM_REPO={{ nextcloud_worm_repo }}
NEXTCLOUD_WORM_ACCESS_KEY_ID={{ nextcloud_worm_access_key | default('') }}
NEXTCLOUD_WORM_SECRET_ACCESS_KEY={{ nextcloud_worm_secret_key | default('') }}
NEXTCLOUD_MIRROR_HEALTHCHECK_URL={{ nextcloud_mirror_healthcheck_url }}
NEXTCLOUD_MIRROR_HEALTHCHECK_ATTEMPTED_URL={{ nextcloud_mirror_healthcheck_attempted_url }}
