# {{ ansible_managed }}
# Sourced by /usr/local/bin/run-disk-watch. Fill-level watchdog for the
# host filesystems: warn via ntfy at {{ disk_watch_warn_pct }}%, page via
# the Healthchecks /fail escalation at {{ disk_watch_crit_pct }}%.
# Empty HC_PING_KEY / NTFY_TOPIC degrade to journal-only logging.
DISK_WATCH_PATHS={{ disk_watch_paths | join(' ') }}
DISK_WATCH_WARN_PCT={{ disk_watch_warn_pct }}
DISK_WATCH_CRIT_PCT={{ disk_watch_crit_pct }}
DISK_WATCH_SLUG={{ disk_watch_slug }}
HEALTHCHECKS_LOOPBACK_PORT={{ healthchecks_host_localhost_port }}
HC_PING_KEY={{ healthchecks_ping_key | default('') }}
NTFY_SERVER={{ ntfy_server | default('') }}
NTFY_TOPIC={{ ntfy_topic | default('') }}
