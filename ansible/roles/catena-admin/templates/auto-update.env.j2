{{ ansible_managed | comment }}
# Per-host configuration for the managed host-package update lane.
#
# catena-auto-update.service, catena-auto-update@.service and
# catena-auto-update-resume.service all declare EnvironmentFile for this path
# with no leading dash, so systemd fails the unit when it is missing. The
# worker also runs under `set -eu`, which turns an unset variable reference
# into an abort -- so every key it reads is written here, blank if it has no
# value on this host, rather than omitted.
#
# Secrets are the exception below: the provider credentials are read from
# /etc/catena/config.json like every other secret, and appear here only when
# the operator has configured a provider.
#
# The SCHEDULE is not here. `catena-schedule apply` owns which timers are
# enabled and at what OnCalendar; this file says only how a run behaves.

# What a run applies, and whether it may reboot afterwards.
AUTO_UPDATE_MODE={{ catena_auto_update_mode }}
AUTO_UPDATE_REBOOT={{ catena_auto_update_reboot }}

# The backup the run takes before it applies anything. Same unit the daily
# chain drives, so a manual apply and a scheduled apply snapshot identically.
AUTO_UPDATE_BACKUP_UNIT={{ backup_systemd_unit_name | default('catena-backup') }}

# Two-phase apply: stage, health-check, then commit or roll back. Off means a
# single-shot apply with no rollback path, which is not a posture we ship.
AUTO_UPDATE_TWO_PHASE=true

# The health signal the rollback decision compares against. Blank Gatus means
# the run falls back to the docker-only baseline rather than assuming healthy.
AUTO_UPDATE_HEALTH_SCRIPT=/usr/local/bin/catena-health-baseline
AUTO_UPDATE_HEALTH_FILE={{ catena_admin_stats_dir }}/health-baseline.json
AUTO_UPDATE_GATUS_API_URL={{ catena_daily_gatus_api_url }}

# How many times a rolled-back apply may retry before it stops trying. Zero is
# the shipped value: a package set that regressed once will regress again, and
# a loop of apply-rollback-apply is worse than a pending update.
AUTO_UPDATE_MAX_ROLLBACK_RETRIES={{ catena_auto_update_max_rollback_retries }}

# Where the state machine records the phase it is in, so the -resume unit can
# finish a run interrupted by the reboot it asked for.
AUTO_UPDATE_STATE_FILE={{ catena_admin_stats_dir }}/auto-update.state

# Abort before apt touches anything if the disk is below this floor. An apply
# that fills the disk mid-transaction is the one failure a rollback cannot fix.
AUTO_UPDATE_PREFLIGHT_MIN_BYTES={{ catena_auto_update_preflight_min_bytes }}
AUTO_UPDATE_DISK_PREFLIGHT_SCRIPT={{ backup_disk_preflight_script | default('/usr/local/bin/catena-disk-preflight') }}

# Per-run update telemetry. Empty is skipped silently.
AUTO_UPDATE_HEALTHCHECK_URL={{ catena_auto_update_healthcheck_url }}

# Optional tier-2 provider disk snapshot taken alongside the restic tag point.
# provider=none is a no-op and is the shipped default: a snapshot API needs
# credentials the client has not necessarily given us.
#
# The three OVH keys are written blank. They are NOT in the on-box store's
# EXTERNAL_SECRETS set, so there is nowhere for an operator to put them today
# -- the names below are what the worker reads, kept present because it runs
# under `set -eu`. Wiring them to the store is a separate task; until then a
# provider other than none has no credentials and the snapshot skips.
AUTO_UPDATE_PROVIDER={{ catena_auto_update_provider }}
AUTO_UPDATE_PROVIDER_SCRIPT=/usr/local/bin/catena-provider-snapshot
AUTO_UPDATE_PROVIDER_OVH_REGION={{ catena_auto_update_provider_ovh_region }}
AUTO_UPDATE_PROVIDER_OVH_VPS_NAME={{ catena_auto_update_provider_ovh_vps_name }}
AUTO_UPDATE_PROVIDER_OVH_APP_KEY={{ vault_ovh_app_key | default('') }}
AUTO_UPDATE_PROVIDER_OVH_APP_SECRET={{ vault_ovh_app_secret | default('') }}
AUTO_UPDATE_PROVIDER_OVH_CONSUMER_KEY={{ vault_ovh_consumer_key | default('') }}
