{{ ansible_managed | comment }}
# Per-host configuration for the catena-daily orchestrator chain.
#
# catena-daily.service and catena-daily-resume.service declare
# EnvironmentFile for this path with no leading dash, so systemd fails the
# unit when it is missing. That is deliberate on their side: a chain that
# ran with every path defaulted would back up the wrong directory and report
# success.
#
# Only paths and toggles live here. Credentials come from
# /etc/catena/config.json, which the engines read directly.
#
# The chain's SCHEDULE is not here -- `catena-schedule apply` owns which
# timers are enabled and at what OnCalendar, from the same config store the
# admin panel writes.

# Where the chain keeps its own state. Under /var/lib/catena, which is in the
# backup set, so a rebuilt host can tell what its predecessor had done.
DAILY_STATE_FILE={{ catena_admin_stats_dir }}/daily.state
DAILY_HISTORY_FILE={{ catena_admin_stats_dir }}/daily-history.json
DAILY_VERIFY_COLD_STATUS_FILE={{ catena_admin_stats_dir }}/daily-verify-cold.status
DAILY_BACKUP_STATS_FILE={{ catena_admin_stats_dir }}/backup-stats.json
DAILY_PREFLIGHT_REPORT_FILE={{ catena_admin_stats_dir }}/preflight.json
DAILY_PKG_PENDING_FILE={{ catena_admin_stats_dir }}/pkg-pending.json
DAILY_CVE_FINDINGS_FILE={{ catena_admin_stats_dir }}/cve-findings.json
DAILY_CONTAINER_CVE_FINDINGS_FILE={{ catena_admin_stats_dir }}/container-cve-findings.json
AUTO_UPDATE_STATE_FILE={{ catena_admin_stats_dir }}/auto-update.state
MAINTENANCE_EMIT_STATE_FILE={{ catena_admin_stats_dir }}/maintenance-emit.state

# Application quiesce hooks. Each template that needs a consistent logical
# dump drops one here; the chain runs them all and knows none of them.
DAILY_QUIESCE_DIR=/etc/catena/quiesce.d

# The lane workers, installed by the payload alongside the engine itself.
DAILY_PREFLIGHT_SCRIPT=/usr/local/bin/catena-daily-preflight
DAILY_VERIFY_HOT_SCRIPT=/usr/local/bin/catena-verify-hot
DAILY_VERIFY_COLD_SCRIPT=/usr/local/bin/catena-verify-cold
DAILY_RESTIC_CHECK_SCRIPT=/usr/local/bin/catena-restic-check
DAILY_CVE_SCAN_SCRIPT=/usr/local/bin/catena-cve-scan
DAILY_PKG_CHECK_SCRIPT=/usr/local/bin/catena-pkg-check
DAILY_CONTAINER_CVE_SCAN_SCRIPT=/usr/local/bin/catena-container-cve-scan
DAILY_MAINTENANCE_LOG_SCRIPT=/usr/local/bin/catena-maintenance-log

# Units the chain drives synchronously rather than scheduling separately.
DAILY_BACKUP_UNIT={{ backup_systemd_unit_name | default('catena-backup') }}
DAILY_SECURITY_UPDATE_UNIT=catena-auto-update@security
DAILY_STACK_UPDATE_UNIT=catena-stack-update-managed
DAILY_RESTIC_MIRROR_UNIT=catena-restic-mirror
DAILY_NEXTCLOUD_MIRROR_UNIT=catena-nextcloud-mirror

# Abort the run before pg_dumpall writes a byte if the staging mount is below
# this floor. The same number the standalone backup preflight uses.
DAILY_PREFLIGHT_MIN_BYTES={{ backup_preflight_min_bytes | default(5368709120) }}
DAILY_PREFLIGHT_STAGING_DIR={{ storage_mount_point }}/backup-staging

# Updates only proceed behind a cold-copy verification. Turning this off means
# applying updates on the strength of a backup nobody has restored from.
DAILY_REQUIRE_COLD_VERIFY_FOR_UPDATES=true

# Pre-update health gate. Blank on a host without Gatus, which the chain
# treats as "cannot ask" rather than as "healthy".
DAILY_GATUS_API_URL={{ catena_daily_gatus_api_url }}

# Debian's apt-daily-upgrade.timer is masked while the chain owns the apply
# lane, and handed back on deactivation or licence lapse.
DAILY_MANAGE_APT_TIMER={{ catena_daily_manage_apt_timer | ternary('true', 'false') }}

# Recovery bundle retention, served by the recovery-downloads sidecar.
DAILY_RECOVERY_EXPORT_DIR={{ backup_export_dir | default('/var/backups/catena-export') }}
DAILY_RECOVERY_EXPORT_KEEP_LAST=1

# Healthcheck lanes. Empty URLs are skipped silently.
#
# The signal goes in the PATH: these URLs carry a query string, and appending
# "/fail" to one puts the signal after the "?", where Healthchecks does not
# look. The engines build their pings with a helper that inserts it ahead of
# the query for exactly that reason.
DAILY_HEALTHCHECK_ATTEMPTED_URL={{ backup_healthcheck_attempted_url | default('') }}
DAILY_HEALTHCHECK_URL={{ backup_healthcheck_url | default('') }}
DAILY_HEALTHCHECK_URL_CLIENT={{ backup_healthcheck_url_client | default('') }}
DAILY_HEALTHCHECK_URL_OPERATOR={{ backup_healthcheck_url_operator | default('') }}
