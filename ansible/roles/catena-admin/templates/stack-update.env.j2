{{ ansible_managed | comment }}
# Per-host configuration for the managed container-bump lane.
#
# catena-stack-update-managed.service declares EnvironmentFile for this path
# with no leading dash, so systemd fails the unit when it is missing.
#
# Every key the engine reads has a compiled-in default, so this file exists to
# carry the values that are per-host (the Portainer API coordinates) and the
# gates an operator would reasonably tune. Writing the defaulted keys as well
# means the effective configuration is readable on the host instead of only in
# the binary.
#
# The SCHEDULE is not here. `catena-schedule apply` owns which timers are
# enabled and at what OnCalendar.

# The spec list: which infra services are eligible for a managed bump, and
# under what policy. Rendered next door by this same role.
MANAGED_SERVICES_FILE={{ catena_managed_services_path }}

# Touch this file to stop the lane bumping anything without disabling the
# timer, so a paused host still reports state.
MANAGED_UPDATE_PAUSE_FLAG=/etc/catena/stack-update.disabled

# State the lane carries between runs: what is at what version, and what was
# quarantined after a rollback so it is not retried on a loop.
MANAGED_VERSIONS_STATE_FILE={{ catena_admin_stats_dir }}/managed-versions.json
MANAGED_VERSIONS_FAILED_FILE={{ catena_admin_stats_dir }}/managed-versions.failed.json
STACK_UPDATE_BASELINE_FILE={{ catena_admin_stats_dir }}/stack-update-baseline.json

# The health signal a bump is judged against, shared with the host-package
# lane so a regression looks the same whichever lane caused it.
HEALTH_BASELINE_SCRIPT=/usr/local/bin/catena-health-baseline

# How long a bumped service must stay healthy before the next one is bumped.
POST_BUMP_STABILIZE_SECONDS={{ catena_stack_update_stabilize_seconds }}

# A tag younger than this is not eligible. An upstream release that gets
# withdrawn is usually withdrawn within days, and this lane runs unattended.
MANAGED_MIN_TAG_AGE_DAYS={{ catena_stack_update_min_tag_age_days }}

# CVE gate. Auto-off when trivy is absent; when present, a candidate image
# carrying a new finding at or above this severity is not bumped to.
MANAGED_CVE_GATE_SEVERITY={{ catena_stack_update_cve_severity }}
MANAGED_CVE_SCAN_MAX_CANDIDATES=4
MANAGED_TRIVY_CACHE_DIR=/var/cache/trivy

# Portainer API coordinates, needed for the compose-stack bump path. The
# control-plane pair below it (swarm service + plain container) is driven
# through docker directly and needs neither.
PORTAINER_API_BASE={{ catena_stack_update_portainer_api_base }}
PORTAINER_API_KEY={{ portainer_api_key | default('') }}
