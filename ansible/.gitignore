# A real inventory is NON-SECRET (.env, hosts.yml, group_vars/all/main.yml --
# see SECRETS.md): every secret lives on the box in /etc/catena/config.json.
# Still untracked, because a .env carries per-client zone/account values.
inventory/*
!inventory/example/
!inventory/README.md

inventory/example/.bootstrap-output.yml

# Galaxy collections vendored by `ansible-galaxy collection install -r
# requirements.yml`. Dot-prefixed because ansible.cfg's collections_path says
# so, and the installer reads that value rather than carrying its own copy --
# the two diverged once and the install wrote where ansible never looked.
.collections/

# Controller-side ansible state + python bytecode from the filter/lookup plugins.
.ansible/
**/__pycache__/
*.pyc

# Installer Python tooling (uv-managed venv + pytest cache + editable-build
# metadata from the `catena-cli` console-script package).
.venv/
.pytest_cache/
*.egg-info/
