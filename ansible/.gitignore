# A real inventory is NON-SECRET (.env, hosts.yml, group_vars/all/main.yml --
# see SECRETS.md): every secret lives on the box in /etc/catena/config.json.
# Still untracked, because a .env carries per-client zone/account values.
inventory/*
!inventory/example/

# Defense-in-depth. `vault.yml` is NOT part of the product -- nothing writes
# one and nothing reads one; a file by that name is either a pre-0b leftover
# or a hand-made one, and both would inject group vars silently (ansible.cfg
# host_group_vars auto-loads group_vars/all/*.yml). Ignored so neither can be
# committed. Same for a .env someone copies in place from the example.
inventory/example/.env
inventory/example/.bootstrap-output.yml
inventory/example/**/vault.yml

# Galaxy collections vendored by `ansible-galaxy collection install -r requirements.yml`.
# Dot-prefixed (see ansible.cfg collections_path) so `go build ./...` at the
# repo root skips the .go test fixtures these collections ship.
.collections/

# Controller-side ansible state + python bytecode from the filter/lookup plugins.
.ansible/
**/__pycache__/
*.pyc

# Installer Python tooling (uv-managed venv + pytest cache + editable-build
# metadata from the `catena` console-script package).
.venv/
.pytest_cache/
*.egg-info/
