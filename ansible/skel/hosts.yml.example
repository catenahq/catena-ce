---
# Copied to an inventory's hosts.yml (gitignored) when it is first installed.
# It names the server: the first host of the `vps` group becomes its
# hostname. An `ansible_host` written under it is the address the installer
# dials, ahead of HOST_SSH_ADDRESS and HOST_PUBLIC_IP in the `.env`.
all:
  children:
    vps:
      hosts:
        host1: {}
