# {{ ansible_managed }}
# SSH client config for the catena-admin container. Used by its
# dispatcher client to reach the host runner account. StrictHostKeyChecking
# is enforced because known_hosts is pre-populated by the role
# (ssh-keyscan) -- if the host key rotates, the role re-runs and updates
# this file.

# HostName is the name the CONTAINER reaches the host by, which is
# host.docker.internal (the extra_hosts host-gateway mapping in the admin
# compose) -- the same name catena-admin shell/actions/dispatcher.go defaults to
# and the same name known_hosts is keyed on via the keyscan_alias filter beside
# it. A constant keeps this file the same on every converge, wherever the
# installer reached the box from.
Host vps
    HostName host.docker.internal
    User {{ catena_admin_runner_user }}
    IdentityFile /etc/catena/admin-ssh/id_ed25519
    UserKnownHostsFile /etc/catena/admin-ssh/known_hosts
    StrictHostKeyChecking yes
    IdentitiesOnly yes
    BatchMode yes
